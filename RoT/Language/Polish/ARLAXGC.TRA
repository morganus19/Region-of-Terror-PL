@0    = ~Przed chwilą uciekł nam więzień, więc nie jestem w najlepszym nastroju. Czego chcesz?~
@1    = ~Więzień uciekł? Jakieś szczegóły?~
@2    = ~Czy to więzienie naprawdę jest takie małe?~
@3    = ~Co zrobiła ta para więźniów?~
@4    = ~Eee... nic. Żegnam.~
@5    = ~Niewiele. Ten gość, Tresham, uciekł pod osłoną nocy. Nikt nic nie widział. Próby odnalezienia go są bezcelowe. On już prawdopodobnie jest w Athkatli.~
@6    = ~Miejscowi rabusie mogą coś wiedzieć, ale on sam jest już poza naszym zasięgiem.~
@7    = ~Mógłbym go spróbować odnaleźć. Popytam trochę o niego.~ ~Mogłabym go spróbować odnaleźć. Popytam trochę o niego.~
@8    = ~Dobrze. Więc, co zrobiła ta para więźniów?~
@9    = ~No cóż... Czy to więzienie naprawdę jest takie małe?~
@10   = ~Już nic. Żegnam.~
@11   = ~Zrobiłbyś to? No cóż, dziękuję ci. Wyznaczono za niego pięćset sztuk złota nagrody. Jeśli go znajdziesz, przyprowadź go tutaj żywego. Martwy wart jest tylko dwieście.~ ~Zrobiłabyś to? No cóż, dziękuję ci. Wyznaczono za niego pięćset sztuk złota nagrody. Jeśli go znajdziesz, przyprowadź go tutaj żywego. Martwy wart jest tylko dwieście.~
@12   = ~Cóż, jeśli musisz wiedzieć, mężczyzna ukradł pieniądze z gospody, a kobieta zamordowała maga.~
@13   = ~A propos tego zbiegłego więźnia, o którym wspomniałeś... Mogę spróbować go odszukać.~
@14   = ~Oczywiście, że nie. Tutaj trzymamy tylko drobniejszych przestępców i tych, którzy już niedługo mają być wypuszczeni. Właściwe więzienie jest znacznie większe.~
@15   = ~Cóż, co zrobiła ta para więźniów?~
@16   = ~Nie zawracaj mi więcej głowy bzdurami.~
@17   = ~No więc, powodzenia w poszukiwaniach. Mam nadzieję, że go odnajdziesz.~
@18   = ~Czy to... zwłoki Treshama?~
@19   = ~Tak. Nie miałem wyboru, musiałem go zabić.~ ~Tak. Nie miałam wyboru, musiałam go zabić.~
@20   = ~Tak! Zabiłem go.~ ~Tak! Zabiłam go.~
@21   = ~Cóż, dzięki ci za przesyłkę! Dobra robota! Nagroda nie jest tak okazała, jak by była, gdyby pozostał przy życiu, ale szczerze mówiąc cieszę się bardziej widząc go martwego, niż żywego.~
@22   = ~Daj mi po prostu ciało, a ja pójdę je spalić.~
@23   = ~Udało ci się go znaleźć! Dobra robota! Oddaj go w moje ręce, a ja zadbam o to, aby nie zdołał uciec po raz drugi.~
@24   = ~A tutaj masz zapłatę. Zasłużyłeś na to.~ ~A tutaj masz zapłatę. Zasłużyłaś na to.~
@25   = ~Dzięki za przyprowadzenie go z powrotem.~