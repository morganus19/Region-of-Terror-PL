@0    = ~Pierwszy krok na tej powierzchni musi doprowadzić nas bliżej mojej córki! Musimy ją uwolnić!~
@1    = ~Znów będę przewodził mym krasnoludom przeciw tym potworom! Nic nie może nas pokonać!~ [BRUEN7]
@2    = ~<CHARNAME> zdradził nas, tak jak to Drizzt przewidział. Do ataku!~ ~<CHARNAME> zdradziła nas, tak jak to Drizzt przewidział. Do ataku!~
@3    = ~Zdrajco! Giń od mego topora!~ [BRUEN12] ~Zdrajczyni! Giń od mego topora!~ [BRUEN12K]
@4    = ~Cóż to? Atakujesz nas? Wulfgar, Regis! Do ataku!~ [BRUEN16]
@5    = ~Potrzebujesz pomocy, Regis? Drizzt wiedział, że <CHARNAME> nas zdradzi, więc was śledziliśmy. Wulfgarze, zabijmy ich!~
@6    = ~Ta, Wulfgarze! Drizzt wiedział, że <CHARNAME> nas zdradzi, więc was śledziliśmy. Regisie, zaczynajmy!~
@7    = ~Potrzebujesz pomocy? Drizzt wiedział, że <CHARNAME> nas zdradzi, więc was śledziłem, by pomóc, kiedy się od nas odwróci. Mój topór zasmakuje twej krwi, zdrajco!~ ~Potrzebujesz pomocy? Drizzt wiedział, że <CHARNAME> nas zdradzi, więc was śledziłem, by pomóc, kiedy się od nas odwróci. Mój topór zasmakuje twej krwi, zdrajczyni!~
@8    = ~Zawsze jestem gotów na dobrą walkę!~ [BRUEN1]
@9    = ~Oczywiście! Stawmy im czoła!~ [BRUEN8]
@10   = ~Gotów! Czas na walkę!~ [BRUEN9]
@11   = ~Fiu! Przegapiłeś całą zabawę!~
@12   = ~Uratowaliśmy ją! Gdzie się podziewałeś dupku żołędny!?~
@13   = ~Poszedł przodem do najbliższego miasta. Wiesz, trzeba zaopiekować się jego żoną tak szybko jak to tylko możliwe.~
@14   = ~Cóż, możesz pójść i obejrzeć to sobie. Niezbyt wiele się tam rusza, tyle ci powiem!~
@15   = ~Zawsze możesz zboczyć ze swej drogi z powrotem, jeśli wiesz, co mam na myśli...~
@16   = ~Taa!~
@17   = ~Jeśli Drizzt odejdzie, to i ja to zrobię!~