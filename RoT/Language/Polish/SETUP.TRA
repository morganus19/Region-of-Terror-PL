@175 = ~Farmer~
@176 = ~Kim jesteś?~ [CHILM01]
@177 = ~Nie krzywdź mnie!~ [CHILM07]
@178 = ~Nie jesteś stąd. Wiem to.~ [CHILM02]
@179 = ~Ekstra! Poszukiwacz przygód!~ [CHILM03]
@180 = ~Nic nie zrobiłem.~ [CHILM04]
@181 = ~N...nie wolno mi rozmawiać z obcymi.~ [CHILF04]
@182 = ~Jesteście obcy!~ [CHILF01]
@183 = ~Nie znam cię wcale. Nie jesteś stąd.~ [CHILF02]
@184 = ~Eee...cześć.~ [CHILF03]
@185 = ~N...nie wolno mi rozmawiać z obcymi.~ [CHILF04]
@186 = ~Żona farmera~
@187 = ~Mistyczne drzwi~
@188 = ~Wyglądasz na porządną osobę.~ [PEASF01]
@189 = ~Niech mi ktoś pomoże!~ [PEASF09]
@190 = ~Dziękuję bogom każdego dnia za wszystko, co dobre w moim życiu.~ [PEASF02]
@191 = ~Żołnierz Straży Miejskiej~
@192 = ~Spokojnie, obywatelu.~ [SOLM03]
@193 = ~Odwrót!~ [SOLM08]
@194 = ~Ostudzę twój zapał zimną stalą!~ [SOLM05]
@195 = ~Przedstaw się!~ [SOLM01]
@196 = ~Nie przeszkadzaj mi w służbie.~ [SOLM02]
@197 = ~Spokojnie, obywatelu.~ [SOLM03]
@198 = ~Wierzę, że nie macie wrogich zamiarów.~ [SOLM04]
@199 = ~Kapitan Straży Miejskiej~
@200 = ~Isac~
@201 = ~Mam mało czasu, więc się streszczaj, prostaku.~ [NOBMA03]
@202 = ~M...muszę uciekać.~ [NOBMA09]
@203 = ~Nabyłem to prawo poprzez moje pochodzenie.~ [NOBMA04]
@204 = ~Mera~
@205 = ~Nie podchodź, wieśniaku.~ [NOBFE203]
@206 = ~Demon! Występny demon!~ [NOBFE209]
@207 = ~To jest poniżej mojej godności odzywać się do ciebie.~ [NOBFE204]
@208 = ~Szlachcic~
@209 = ~Szlachcianka~
@210 = ~Obcy~
@211 = ~Podróżny~
@212 = ~Ashamael~
@213 = ~Grog~
@214 = ~Mag bitewny~
@215 = ~Bruno Bernardi~
@216 = ~Chłopiec~
@217 = ~Beleth~
@218 = ~Beogorn~
@219 = ~Bhelal~
@220 = ~Biggs~
@221 = ~Niebieski smok~
@222 = ~Elle~
@223 = ~Krasnolud~
@224 = ~Deli Delta~
@225 = ~Mateusz Wyndon~
@226 = ~Lodowy olbrzym~
@227 = ~Pustelnik~
@228 = ~Lamorine~
@229 = ~Torvald~
@230 = ~Wieśniak~
@231 = ~Ciesz się, przyjacielu.~ [PEASM201]
@232 = ~Witaj i powodzenia.~ [PEASM202]
@233 = ~Bruenor~
@234 = ~Myślę, że dokończymy to później...~ [BR_MORAL]
@235 = ~Razem tworzymy niezły duet!~ [BR_HAPP]
@236 = ~Twoja reputacja nie zbyt dobra! To szkodzi MOJEJ, co NIE jest dobre!~ [BR_UNHA]
@237 = ~Cóż z ciebie za przeklęty demon? Zmień swoje postępowanie, albo mój topór zmieni swą drogę prosto na twój czerep!~ [BR_UNHS]
@238 = ~Masz piekielne szczęście, że nie rozszczepię twej czaszki na pół! Żegnaj!~ [BR_UNHB]
@239 = ~No wreszcie! Jestem urodzonym przywódcą!~ [BR_LEAD]
@240 = ~No ruszmy się gdzieś wreszcie!~ [BR_BORE]
@241 = ~Przygotuj się na randkę z moim toporem!~ [BR_CRY1]
@242 = ~Podejdźże bliżej! Czas UMRZEĆ!~ [BR_CRY2]
@243 = ~Mniej więcej teraz dostarczysz mi trochę ruchu!~ [BR_CRY3]
@244 = ~Uch!~ [BR_DAM]
@245 = ~AAAaaa!~ [BR_DIE]
@246 = ~Ha! Te draśnięcia nie mogą mnie zmartwić!~ [BR_HURT]
@247 = ~Przeklęty dom dla leśnych elfów...~ [BR_ARFOR]
@248 = ~Przeklęci ludzie...„Nie jesteś godzien naszego wspaniałego miasta...”~ [BR_ARC]
@249 = ~W takich miejscach zazwyczaj jest więcej do zabicia...~ [BR_ARDU]
@250 = ~Ach... cóż za cudny czas na zabijanie!~ [BR_ARDA]
@251 = ~Nie przejmuj się! Mój topór jest gotowy na wszelkie niespodzianki...~ [BR_ARNI]
@252 = ~Mów, czego chcesz!~ [BR_COM1]
@253 = ~Czegóż potrzebujesz?~ [BR_COM2]
@254 = ~Lepiej, żeby to było coś ważnego!~ [BR_COM3]
@255 = ~Czy to czas na zabijanie?~ [BR_COM4]
@256 = ~Masz powód, by mnie męczyć?~ [BR_COM5]
@257 = ~Tym razem niech coś się zdarzy!~ [BR_COM6]
@258 = ~Tak jest!~ [BR_ACT1]
@259 = ~Chodźmy! Mój topór wskaże nam drogę!~ [BR_ACT2]
@260 = ~Uważaj to za zrobione...~ [BR_ACT3]
@261 = ~Z drogi! Nadchodzi wściekły krasnolud z dużym toporem!~ [BR_ACT4]
@262 = ~Co to za głupi rozkaz!?~ [BR_ACT5]
@263 = ~Świetnie!~ [BR_ACT6]
@264 = ~Nie zapomną mojego topora...~ [BR_ACT7]
@265 = ~To musiało boleć!~ [BR_CHIT]
@266 = ~Stój w miejscu! Myślisz, że bawią mnie twoje tańce!?~ [BR_CMISS]
@267 = ~Niezły pasztet! Broń mi nie działa!~ [BR_IMM]
@268 = ~Zabieraj tego śmiecia! Nie przeładowuj wściekłego krasnoluda!~ [BR_IFULL]
@269 = ~Nie jest dobrze! Ale i tak będą słyszeć mój okrzyk bojowy...~ [BR_HIDD]
@270 = ~Przeklęta magia! Nie martwi mnie jej utrata!~ [BR_LMAG]
@271 = ~Zapytany o przeszłość BRUENOR Waleczny Młot, wiecznie rozdrażniony przywódca krasnoludów z Doliny Lodowego Wichru, pomija czasy swej młodości i zaczyna opowieść o swoich związkach z przyjaciółmi. Uratował, adoptował i wychował młodą ludzką dziewczynę, Catti-Brie, która straciła rodziców podczas ataku jakiejś szajki złodziei, a także udzielił schronienia mrocznemu elfowi, Drizztowi Do'Urdenowi. Z kolei po odparciu napaści barbarzyńców ocalił życie pewnemu pojmanemu wówczas młodziakowi pod warunkiem pięcioletniej służby tegoż u Bruenora. Barbarzyńcę tego zwano Wulfgarem.

Z biegiem lat wszyscy oni – Bruenor, Drizzt i Wulfgar – stali się przyjaciółmi, dodatkowo tego ostatniego z Catti-Brie połączyły więzy wzajemnej miłości. Po upływie pięciu lat Bruenor wykuł młot bojowy zwany Aegis-Fangiem i ofiarował go Wulfgarowi. Mimo, iż dla tego skończył się właśnie okres przyrzeczonej służby, z racji faktu, że zakochał się w przybranej córce krasnoluda, zdecydował się pozostać.

Pewnego dnia bez słowa wyjaśnienia przybył w poszukiwaniu schronienia przyjaciel Bruenora, Regis. Krasnolud oczywiście przyjął niziołka, czego ostatecznym skutkiem było uwolnienie Doliny z Odłamka kryształu, w czym udział miała cała piątka. Następnie przewodził im w misji odbicia z rąk duergarów legendarnego Mithrilowego Dworu.

Wewnątrz spotkali prawdziwego zdobywcę Dworu, czarnego smoka. Bruenor zabił go, jednak wraz z nim spadł w szczelinę. I przeżył. Po śmierci gada krasnoludy zdobyły Mithrilowy Dwór, a Bruenor został królem.

Jakiś czas potem podczas ataku drowów na Mithrilowy Dwór pierwszy król Klanu Waleczny Młot uwolnił się ze swego wieczystego więzienia w Menzoberranzan i zgotował swym nagłym powrotem do życia po upływie setek lat wielką niespodziankę. Po pierwszym zaskoczeniu Bruenor przekazał klanową władzę w ręce pierwszego władcy, zyskując dzięki temu ponowną możliwość udania się na wędrówkę ze swymi przyjaciółmi.

Bruenor jest niezwykle upartym, nieugiętym i zapalczywym krasnoludem, który rozmawia ze swymi przeciwnikami toporem. Pomimo tego, że wygląda na nieprzystępnego, ma czułe serce, jednak odradza się krzyżować z nim broń.~
@272 = ~Brundor~
@273 = ~Bryne~
@274 = ~Burrich~
@275 = ~Władca balorów~
@276 = ~Xer~
@277 = ~Carethron~
@278 = ~Lord Bane'a~
@279 = ~Ręka zła~
@280 = ~Heraldyk~
@281 = ~Brat Haroldus~
@282 = ~Brat Mattheus~
@283 = ~Brat Gheradius~
@284 = ~Brat Pelvarius~
@285 = ~Brat Quintius~
@286 = ~Brat Lucius~
@287 = ~Brat Talvanus~
@288 = ~Caern~
@289 = ~Cain~
@290 = ~Cal'Dar~
@291 = ~Cal'Torn~
@292 = ~Strażnik zamku~
@293 = ~Perrim Haybath~
@294 = ~Syn Perrima~
@295 = ~Catti-Brie~
@296 = ~Cieszę się, że jestem członkiem tej drużyny. Twoje poglądy cechuje mądrość.~ [CAT_HAP]
@297 = ~Nie jestem zadowolona ze ścieżki, którą podążamy...~ [CAT_ANN]
@298 = ~Ostatnio bardzo rozczarowuje mnie podróżowanie z tobą.~ [CAT_SER]
@299 = ~Dość znaczy dość! Jeśli zobaczę cię znowu, oznaczać to będzie walkę!~ [CAT_BRE]
@300 = ~Nie mam doświadczenia w dowodzeniu, ale jeśli sobie życzysz...~ [CAT_LEA]
@301 = ~Nie przydałoby się nam odpocząć? Z tego co zauważyłam, potrzebujemy trochę snu.~ [CAT_TIR]
@302 = ~*ziewa*~ [CAT_BOR]
@303 = ~Zobaczymy, jak walczysz!~ [CAT_CRY1]
@304 = ~Strzeż się! Wygląd bywa złudny!~ [CAT_CRY2]
@305 = ~Możesz tego uniknąć!?~ [CAT_CRY3]
@306 = ~Oj!~ [CAT_DAM]
@307 = ~*umiera*~ [CAT_DEA]
@308 = ~... Ja... ja potrzebuję leczenia... im szybciej tym lepiej...~ [CAT_HUR]
@309 = ~Dla łucznika, las jest idealnym miejscem do ukrycia się.~ [CAT_FOR]
@310 = ~Moje obycie w mieście jest nikłe. Dorastałam przecież w jaskiniach.~ [CAT_CIT]
@311 = ~Bądźmy naprawdę ostrożni. Nigdy nie wiadomo, co może się czaić w takich miejscach jak to.~ [CAT_DUN]
@312 = ~Wędrowanie wydaje mi się teraz całkiem przyjemne...~ [CAT_DAY]
@313 = ~Nigdy nie wiesz, czy ktoś nie obserwuje cię z ukrycia...~ [CAT_NIG]
@314 = ~Jestem potrzebna?~ [CAT_COM1]
@315 = ~Tak?~ [CAT_COM2]
@316 = ~Jestem na twe rozkazy.~ [CAT_COM3]
@317 = ~Jak mogę ci pomóc?~ [CAT_COM4]
@318 = ~Co mogę dla ciebie zrobić?~ [CAT_COM5]
@319 = ~Jestem gotowa.~ [CAT_COM6]
@320 = ~Uważaj to za zrobione!~ [CAT_ACT1]
@321 = ~Chętnie.~ [CAT_ACT2]
@322 = ~Idę.~ [CAT_ACT3]
@323 = ~Rozsądny wybór.~ [CAT_ACT4]
@324 = ~Zrobię to najlepiej, jak potrafię.~ [CAT_ACT5]
@325 = ~Jestem dumna, że mogę ci pomóc.~ [CAT_ACT6]
@326 = ~Zrobię to.~ [CAT_ACT7]
@327 = ~Tak!~ [CAT_HIT]
@328 = ~To się już więcej nie powtórzy!~ [CAT_MIS]
@329 = ~Nie widzę żadnych ran!~ [CAT_IMM]
@330 = ~Czy nie mógłby tego wziąć ktoś inny?~ [CAT_INVF]
@331 = ~Domyślam się, że w ogóle mnie nie widać...~ [CAT_INV]
@332 = ~Straciłam czar!~ [CAT_LOS]
@333 = ~Zapytana o przeszłość CATTI-BRIE snuje opowieść o swoim dotychczasowym życiu. We wczesnej młodości, podczas ataku szajki złodziei, straciła rodziców, została jednak uratowana przez przywódcę krasnoludów, Bruenora Walecznego Młota, który przygarnął ją jako swoją adoptowaną córkę, a kiedy zmusił do pięcioletniej służby Wulfgara, spotkała swoją przyszłą miłość. Później spotkała także mrocznego elfa Drizzta i niziołka Regisa.

Najwięcej radości sprawiało jej towarzystwo Wulfgara i po wielu wspólnych przygodach przypuszczali, że zwiążą się węzłem małżeńskim, jednak pewne, nieoczekiwane zdarzenie zburzyło te plany. Wulfgar poległ w bitwie i sądzono, że umarł. W rzeczywistości został pochłonięty przez jedno z piekieł, gdzie przez sześć długich lat był poddawany torturom przez demona Errtu.

Po uwolnieniu próbował przywrócić dawne uczucie, które łączyło go z Catti-Brie, jednak ostatecznie wygasło, kiedy Wulfgar ją zaatakował i opuścił drużynę. Od tej chwili to Drizzt stawał się jej coraz bliższy i bliższy. Później, kiedy Wulfgar stawił czoła swym cierpieniom z przeszłości i ku zaskoczeniu wszystkich powrócił z żoną i dzieckiem, nie dotknęło go, że między Catti-Brie i Drizztem rozkwitło znajome mu uczucie.

Catti-Brie słynie w całym świecie ze swej urody i umiejętności posługiwania się magicznym łukiem, Taulmarilem, Poszukiwaczem Serc, z którego, jak powiadają, nigdy nie chybia. Pod okiem Drizzta, który uświadomił jej także przesłanie bogini Mielikki, dzięki czemu mogła stać się łowczynią, nauczyła się również władać mieczem.~
@334 = ~Chade~
@335 = ~Brat Chaunticleerius~
@336 = ~Choyol~
@337 = ~Chu'yol~
@338 = ~Chxzar~
@339 = ~Clob~
@340 = ~Colbert~
@341 = ~Cratzyl~
@342 = ~Kultysta~
@343 = ~Pomniejszy kultysta~
@344 = ~Kapłan kultu~
@345 = ~Fremor Widmowy Ogon~
@346 = ~Opiekun~
@347 = ~Najwyższy~
@348 = ~Wzmocniony szlam~
@349 = ~Wściekły czarny niedźwiedź~
@350 = ~Wściekły niedźwiedź~
@351 = ~Wojownik grozy~
@352 = ~Wzmocniony szkielet~
@353 = ~Człowiek~
@354 = ~Poświęcony~
@355 = ~Przywódca cyklopów~
@356 = ~Cyklop~
@357 = ~Fanguarrax~
@358 = ~Deano~
@359 = ~Delei~
@360 = ~Deneir~
@361 = ~Mag straceniec~
@362 = ~Boski strażnik~
@363 = ~Drizzt Do'Urden~
@364 = ~Wybacz, ale muszę się wycofać, jeśli mam znowu dla ciebie walczyć...~ [Dr_MORA]
@365 = ~Nie było błędem dołączyć do ciebie.~ [DR_HAPP]
@366 = ~Nie podoba się mi kierunek, który wyznaczają nasze ostatnie czyny.~ [DR_UNHA]
@367 = ~Muszę cię ostrzec, że jestem bliski porzucenia twojego towarzystwa.~ [DR_UNHS]
@368 = ~Nie mam ochoty spędzić nawet minuty dłużej w obecności kogoś takiego, jak wy.~ [DR_UNHB]
@369 = ~Z chęcią poprzewodzę i pokażę ci drogę.~ [DR_LEAD]
@370 = ~Nawet drow potrzebuje nieco odpoczynku.~ [DR_TIRE]
@371 = ~Takie stanie w miejscu raczej w niczym nie pomoże, ruszajmy.~ [DR_BORE]
@372 = ~Zmierz się ze mną, tchórzu!~ [DR_CRY1]
@373 = ~Pozwól mi pokazać ci właściwą drogę, do wieczności!~ [DR_CRY2]
@374 = ~W imię prawości, uderzam!~ [DR_CRY3]
@375 = ~Ach!~ [DR_DAM]
@377 = ~Jeśli mam dalej walczyć, potrzebuję leczenia.~ [DR_HURT]
@378 = ~Chociaż dorastałem w jaskiniach, znacznie bardziej lubię lasy.~ [DR_ARFO]
@379 = ~Nigdy nie czuję się zbyt komfortowo w miastach. Zbyt często spotykam się tu z wrogością.~ [DR_ARCI]
@380 = ~Podziemia. Prawie jak w domu!~ [DR_ARDU]
@381 = ~Potrafisz cieszyć się słońcem?~ [DR_ARDA]
@382 = ~Powinniśmy uważać. Nocą trudniej dojrzeć nieprzyjaciół.~ [DR_ARNI]
@383 = ~Jestem gotów.~ [DR_SEC3]
@384 = ~Po prostu wskaż mi cel.~ [DR_SEC2]
@385 = ~Zaufaj moim zmysłom.~ [DR_SEC4]
@386 = ~O co chodzi?~ [DR_SEC5]
@387 = ~Wskaż drogę.~ [DR_SEC6]
@388 = ~Mam nadzieję, że to nie pułapka.~ [DR_SEA1]
@389 = ~Jeśli tego pragniesz.~ [DR_SEA2]
@390 = ~Zaufam ci.~ [DR_SEA3]
@391 = ~To jest następny cel?~ [DR_SEA4]
@392 = ~Jestem pewien, że wiesz, co czynisz.~ [DR_SEA5]
@393 = ~Poprowadzę.~ [DR_SEA6]
@394 = ~Chętnie.~ [DR_SEA7]
@395 = ~Tak!~ [DR_CRIT]
@396 = ~Pech.~ [DR_CRM]
@397 = ~Moja broń nie działa!~ [DR_IMM]
@398 = ~Nie mogę nieść niczego więcej. Wybacz.~ [DR_INVF]
@399 = ~Nikt mnie teraz nie widzi.~ [DR_HIDD]
@400 = ~Magia przepadła!~ [DR_LOSM]
@401 = ~Zapytany o przeszłość DRIZZT Do'Urden, prawdopodobnie najlepszy drowi wojownik w dziejach, zaczyna swoją opowieść od swoich narodzin w Menzoberranzan, które jednak nigdy nie stało się jego prawdziwym domem. Powodem był fakt, że drowy to okrutne istoty przesiąknięte złem. W przeciwieństwie do Drizzta, dla którego jedynym oparciem był jego ojciec, Zaknafein. Cóż, tak naprawdę Drizzt nie miał innego wyboru, niż pozostawać w centrum wszelkiego rodzaju grozy i okrucieństwa i kształcić się w walce sejmitarami. Stał się słynnym ze swej biegłości, jednak kiedy matka przełożona domu Do'Urden zamordowała Zaknafeina, porzucił swe dziedzictwo.

Zbiegł w niebezpieczne i niekończące się jaskinie Podmroku, skąd wywalczył sobie drogę na powierzchnię. Drowy są tam znienawidzoną rasą, tak więc dla Drizzta nastały ciężkie czasy, z początku wszyscy byli względem niego wrodzy, jednak z czasem okazał się zdolnym znaleźć kilku przyjaciół, jak Montolio, który nauczył go być łowcą bogini Mielikki, czy Bruenor, który ofiarował mu dach nad głową. Dom.

Później spotkał Regisa, Wulfgara i Catti-Brie. W piątkę (Bruenor, Regis, Drizzt, Wulfgar i Catti-Brie) uwolnili Dolinę Lododwego Wichru z Odłamka kryształu, przywrócili Mithrilowy Dwór krasnoludom i dokonali wielu innych heroicznych czynów. Kiedy Wulfgar poległ w bitwie i uznany został za martwego, Drizzt i Catti-Brie zbliżyli się do siebie. Minęło sześć lat i kiedy Drizzt udzielał pomocy w ściganiu piratów na okręcie dowiedział się, że jego ojciec wciąż żyje i jest torturowany w otchłaniach piekielnych przez potężne demony. Wyruszył więc ze swymi towarzyszami, by uwolnić swego ojca i móc przyprowadzić go z powrotem. Nie był to jednak jego ojciec, a Wulfgar, który przez wszystkie te lata był torturowany i jego powrót ucieszył wszystkich, jednak wynikła sytuacja była dość niezręczna. Wulfgar i Catti-Brie byli wcześniej kochankami. Tym razem próbowali być nimi ponownie, jednak bez powodzenia. Wulfgar porzucił towarzyszy, a Drizzt i Catti-Brie na nowo zbliżyli się do siebie. Kiedy Wulfgar pogodził się ze sobą, postanowił ostatecznie wrócić, by zostać z przyjaciółmi. W tym czasie miał już żonę i dziecko, zaakceptował też związek Drizzta z Catti-Brie.

Drizzt posiada figurkę pantery. Może z jej pomocą przywołać swą przyjaciółkę, panterę Guenhwyvar by walczyła po jego stronie, Jest ona jego najwierniejszą przyjaciółką i nie ma znaczenia, czemu trzeba stawić czoła, zawsze sobie pomogą.~
@402 = ~Edomis Błotozamki~
@403 = ~Trevis~
@404 = ~Drent~
@405 = ~Eleana~
@406 = ~Elrick~
@407 = ~Raistlin~
@408 = ~Artemis Entreri~
@409 = ~Podoba mi się sposób, w jaki załatwiasz swoje sprawy...~ [EN_HAPP]
@410 = ~Jarlaxle, myślę, że powinniśmy ponownie przemyśleć naszą decyzję odnośnie dołączenia do tej drużyny...~ [EN_UNHA]
@411 = ~Sprawiasz, że wokół nas jest zbyt dużo szumu. Lepiej przestańmy być tak „bohaterscy”...~ [EN_UNHS]
@412 = ~Podróżowanie z tobą staje się zbyt niebezpieczne. Żegnaj!~ [EN_UNHB]
@413 = ~Wreszcie zaczynasz działać rozsądnie.~ [EN_LEAD]
@414 = ~Odpocznijmy przez chwilę. Co ty na to?~ [EN_TIR]
@415 = ~Chodźmy!~ [EN_BORED]
@416 = ~Dalej! Pokaż, na co cię stać!~ [EN_CRY1]
@417 = ~Nie martw się! Sprawię, że szybko odejdziesz!~ [EN_CRY2]
@418 = ~Czas na mały taniec!~ [EN_CRY3]
@419 = ~Uch!~ [EN_DAM]
@420 = ~Czemuż z tobą poszedłem...!?~ [EN_DIE]
@421 = ~... Mamy problem...~ [EN_HURT]
@422 = ~To przypomina mi Calimport...~ [EN_CITY]
@423 = ~W podziemiach jest wiele miejsc, gdzie można się ukryć.~ [EN_DUN]
@424 = ~Noc jest porą zabójców i złodziei...~ [EN_NIG]
@425 = ~Czego?~ [EN_COM1]
@426 = ~Kogo teraz mam zabić?~ [EN_COM2]
@427 = ~Mój sztylet jest na twe rozkazy...~ [EN_COM3]
@428 = ~Czy to ta chwila?~ [EN_COM4]
@429 = ~Tak? Powiedz mi, czego chcesz.~ [EN_COM5]
@430 = ~Nie kuś losu...~ [EN_COM6]
@431 = ~Dobra.~ [EN_ACT1]
@432 = ~Zrobię to... by cię „zadowolić”...~ [EN_ACT2]
@433 = ~Nie widzę w tym sensu...~ [EN_ACT3]
@434 = ~Po prostu poczekaj...~ [EN_ACT4]
@435 = ~Tak zrobię.~ [EN_ACT5]
@436 = ~Zrobię, jak sobie życzysz, tym razem.~ [EN_ACT6]
@437 = ~Świetnie.~ [EN_ACT7]
@438 = ~Teraz porozmawiamy!~ [EN_CHIT]
@439 = ~Ups... To rzadko się zdarza...~ [EN_CMISS]
@440 = ~Co!? Żadnych ran?~ [EN_IMM]
@441 = ~Nie mogę unieść tego wszystkiego!~ [EN_IFULL]
@442 = ~... Dostałem... coś...~ [EN_PICK]
@443 = ~Szlag! Tracę magię!~ [EN_LMAG]
@444 = ~Wolałbym pokonać moich wrogów w uczciwym boju...~ [EN_TRAP]
@445 = ~Zapytany o przeszłość ARTEMIS Entreri, jeden z najlepszych ludzkich wojowników, zaczyna swą opowieść od ulic Calimportu, gdzie dorastał i trenował, szybko stając się szanowanym i przerażającym zabójcą, zawsze zwycięskim, nigdy nie odczuwającym litości wobec swoich ofiar.

Bruenora, Regisa, Drizzta, Catti-Brie i Wulfgara poznał, kiedy został wysłany w celu porwania Regisa, by ukraść amulet Paszy Pookowi. Dostał niziołka, wysłał go z powrotem do Paszy, rzucając w tym czasie na siebie iluzję, by wyglądać jak Regis. Drizzt i pozostali sądzili, że mają do czynienia z prawdziwym Regisem, kiedy wyruszyli razem do Mithrilowego Dworu. Tam Entreri ujawnił swe prawdziwe oblicze i zmierzył się z Drizztem po raz pierwszy. Po walce Drizzt stał się jego obsesją. Wiele razy krzyżował z nim broń, jednak żadna z walk nie skończyła się śmiercią któregoś z nich.

Kiedy Entreri przybył do miasta drowów, Menzoberranzan, spotkał Jarlaxle'a. Stali się towarzyszami, a Jarlaxle zdobył Odłamek kryształu. Razem zwabili Drizzta do Kryształowej Wieży i tam Entreri i Drizzt starli się po raz ostatni. Entreri sądził, że Drizzt zginął i jego obsesja wygasła.

Jednakże Drizzt nie umarł, Jarlaxle oszukał Entreriego, by ten myślał, że to zostało dokonane, podczas gdy w rzeczywistości zostawił drowa w spokoju.

Później Entreri zauważył, że Odłamek kryształu usidlił Jarlaxle'a. Zaczął sprowadzać do Calimportu drowy i jakiegoś rodzaju najazd był tylko kwestią czasu. Entreri obmyślił plan kradzieży Odłamka i zrealizował go. W tym samym czasie Jarlaxle został zdradzony przez jednego ze swoich poruczników, i wraz z Entrerim musieli ratować się i Odłamek ucieczką. Entreri domagał się unicestwienia artefaktu, więc wspólnie zabrali go do kapłana Cadderliusa, który pomógł im go zniszczyć.

Następnie obaj wyruszyli w podróż dookoła świata i krótko potem coś znaleźli...~
