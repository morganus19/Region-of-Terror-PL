@0 = ~Region of Terror mod do BG II EE, EET, BG II i BGT~
@1 = ~Przetwarzanie początkowych poleceń...~
@2 = ~Przywracanie konfiguracji obecnej gry...~
@3 = ~Uzupełnianie zasad...~
@4 = ~Dodawanie nowych animacji pocisków (projectiles)...~
@5 = ~Uzupełnianie plików 2DA...~

@7 = ~Żrący topór +3~
@8 = ~Łuk odzwierciedlenia +3~
@9 = ~Sejmitar Rakha +4~
@10 = ~Kostur rozproszenia +3~
@11 = ~Krakatau +3~
@12 = ~Przywoływacz +3~
@13 = ~Podróż na północ~
@14 = ~Przygotowania do podróży zostały zakończone i wyruszyliście do Doliny Lodowego Wichru. Droga wiedzie do Wrót Baldura, a stamtąd poprzez morze. Po tygodniu obcowania ze słoną wodą i piratami, cumujecie w porcie Luskan. Zatrzymujecie się tam na chwilę, by uzupełnić zapasy, a następnie wyruszacie w dalszą podróż do Dolin. Wreszcie po nużących tygodniach wędrówki, docieracie do wioski Bremen. Wygląda na to, że właśnie stoczono tu bitwę, skutkiem czego doki zostały zniszczone. Tylko jeden statek jest gotowy do wyjścia w morze.~ [LEKROT04]
@15 = ~Wyprawa na północ zakończyła się powodzeniem i już czas, by opuścić dolinę. Po tygodniach wędrówki wreszcie powracacie, a wasze oczy wita widok solidnych murów Athkatli.~ [LEKROT01]
@16 = ~Wzlatująca Dusza~
@17 = ~Kapłan Deneira, Cadderlius, wpadł w kłopoty, a ty spieszysz mu z pomocą. Demony z piekieł przybyły przez portal i zajęły jego świątynię. Jeśli nikt nic nie uczyni, wkrótce wydostaną się na wolność. Teraz bardziej niż kiedykolwiek potrzeba bohaterskich czynów. Portal prowadzący do piekieł musi zostać zablokowany, w przeciwnym razie demony sprowadzą na świat niewyobrażalny terror i splamią te ziemie swoim plugastwem.~ [LEKROT02]
@18 = ~Zadanie we Wzlatującej Duszy zakończyło się powodzeniem i demony zostały odesłane z powrotem do Otchłani, gdzie ich miejsce. Mając ciągle w pamięci straszne wydarzenia, które rozegrały się w świątyni, wracasz do Amn.~ [LEKROT03]
@19 = ~Dodawanie zasady ograniczenia PD do 50. poziomu (Level-50 Ruleset)...~
@20 = ~Instalowanie dialogów...~
@21 = ~Uzupełnianie istniejących skryptów...~
@22 = ~Dodawanie nowych skryptów...~
@23 = ~Uzupełnianie istniejących obszarów...~
@24 = ~Dodawanie nowych obszarów...~
@25 = ~Kiedy odwracasz wzrok, widzisz tylko mrok.~
@26 = ~Wygląda, jakby tu gdzieś były stworzenia jakieś.~
@27 = ~Wygląda, że w tych „słojach” gdzieś, stworzenia się kryją jakieś.~
@28 = ~„Klucz leży pod smokiem”.~
@29 = ~Te runy wydają się w jakiś sposób cię chronić. Możesz bez problemu oddychać i iść po... niczym.~
@30 = ~Powieszono tu dwie martwe kapłanki. Jedna ma tylko jedną nogę a druga jedną rękę.~
@31 = ~Powieszona tu kapłanka wydaje się być w dobrym stanie, chociaż jest martwa.~
@32 = ~Nogi tej powieszonej kapłanki zostały zjedzone.~
@33 = ~Przejście jest zawalone.~
@34 = ~Wejście zostało zapieczętowane.~
@35 = ~Dostrzegasz długi rząd trumien. Ozdabiające je szkielety wyrzeźbione są z kamienia.~
@36 = ~Rzeźby na tych trumnach są zdekompletowane.~
@37 = ~Przyzywańce pojawiają się w obrębie tego okręgu.~
@38 = ~Przejście do kwater kapłanów jest zawalone.~
@39 = ~Drzewa blokują wejście do jaskini.~
@40 = ~Wygląda na to, że potwory zabiły ponownie...~
@41 = ~Te wozy prawdopodobnie należą do Handsa.~
@42 = ~Basen jest wypełniony szkieletami. Dostrzegasz także kilka nieskonsumowanych dotychczas ciał.~
@43 = ~Wejście zostało zablokowane. Przyczyną być może była jego bezużyteczność w tym miejscu.~
@44 = ~Możesz podążyć przejściem do portalu, by opuścić to miejsce.~
@45 = ~Nie wolno ci wejść tymi schodami.~
@46 = ~Tu możesz się nauczyć o plikach 2DA i IDE.~
@47 = ~Tu możesz się nauczyć o edytowaniu BAM-ów.~
@48 = ~Tu możesz się nauczyć o tworzeniu/edytowaniu stworzeń.~
@49 = ~Tu możesz się nauczyć o edytowaniu dialogów, pisaniu skryptów, zmiennych globalnych i NPC-ach.~
@50 = ~Tu możesz się nauczyć o tworzeniu/edytowaniu efektów.~
@51 = ~Tu możesz się nauczyć o limicie Punktów Doświadczenia.~
@52 = ~Tu możesz się nauczyć o tworzeniu nowych obszarów z IETME.~
@53 = ~Tu możesz się nauczyć o tworzeniu nowych przedmiotów, czarów i sklepów.~
@54 = ~Opuść ten głupi pokój.~
@55 = ~Tu możesz się nauczyć o Launcher Editor.~
@56 = ~Tu możesz się nauczyć o tworzeniu/edytowaniu podklas.~
@57 = ~To nie prowadzi dokądkolwiek.~
@58 = ~Tu możesz się nauczyć o tworzeniu/edytowaniu MOS-ów.~
@59 = ~Tu możesz się nauczyć o kluczowych programach w modowaniu.~
@60 = ~Tu możesz się nauczyć o edytowaniu plików dźwiękowych.~
@61 = ~Tu możesz się nauczyć o programie WinBiff.~
@62 = ~Tu możesz się nauczyć o VVC Utility i Projectile Utility.~
@63 = ~Wygląda, jakby tu gdzieś były magiczne drzwi jakieś. Niewidzialne. Te widzialne, otwarte, mogą być zaledwie mirażem. Rozpoznajesz w tym rękę czarodzieja.~
@64 = ~„Istnieją dalece bardziej niebezpieczne zakończenia, niż śmierć.”~
@65 = ~Wygląda na to, że głęboki bardzo jar jest tu jakiś. Jest tak ciemny, że nie masz pewności, w którym miejscu znajduje się krawędź urwiska.~
@66 = ~Wygląda na to, że niewidzialna jakaś znajduje się tu brama. Nie powinno przysporzyć ci problemów przejście przez nią.~
@67 = ~Nie masz bladego pojęcia, czym może być ta dziwna bryła.~
@68 = ~Wygląda na to, że dalej przejście prowadzi w prawo.~
@69 = ~Ten tunel jest tak długi, że nie możesz dojrzeć drugiego końca.~
@70 = ~To przejście prowadzi głęboko w głąb gór.~
@71 = ~Jaskinia jest zawalona.~
@72 = ~To przejście jest wypełnione lodem, który uniemożliwia ci wejście.~
@73 = ~Te schody są niedokończone.~
@74 = ~Zejście śmiertelne.~
@75 = ~„Jeśliś nie w biegu, stań daleko od brzegów. Poświęć minutę czasu swego i wysłuchaj Nadawcy naszego.”~
@76 = ~„Komnata Lecznicza. Uwierz.”~
@77 = ~Kuźnia~
@78 = ~Stara kuźnia~
@79 = ~Najwyższa Rada Magów~
@80 = ~Tawerna~
@81 = ~Więzienie~
@82 = ~Świątynia Helma~
@83 = ~U Osgila – Bronie i Zbroje~
@84 = ~Bibliofil~
@85 = ~W końcu tego korytarza dostrzegasz schody.~
@86 = ~Orientujesz się, że to wejście jest mistyfikacją.~
@87 = ~Droga na górę została zablokowana.~
@88 = ~Zauważasz, że na końcu tego pasażu znajdują się prowadzące do miasta wąskie kładki.~
@89 = ~Ten budynek wygląda bardzo dziwnie. Potrzebny ci będzie specjalny klucz, by otworzyć jego drzwi.~
@90 = ~Wygląda na to, że miejscowi stronią od tego budynku, na ile to tylko możliwe.~
@91 = ~Wiejski cmentarz. Większość pochowanych poległa w bitwie.~
@92 = ~Ścieżka jest zablokowana. Nie możesz powrócić.~
@93 = ~„Grób chrobrego wodza Tapia Perkiomakiego”~
@94 = ~Byłoby targnięciem się na własny żywot, próbować przejść ten korytarz bez przyzwolenia Świętego Strażnika.~
@95 = ~Kolejna ścieżka ponownie okazuje się zablokowana. Nie możesz opuścić tego miejsca.~
@96 = ~Potrzebny ci będzie specjalny klucz, by otworzyć te drzwi.~
@97 = ~Posąg Bogini Waukeen.~
@98 = ~Zauważasz, że te schody nigdzie nie prowadzą.~
@99 = ~Wygląda na to, że są tu też schody, są one jednak zbyt małe dla ciebie.~
@100 = ~Zauważasz, że te schody są niekompletne i donikąd nie prowadzą.~
@101 = ~Nie byłoby wskazane teraz wychodzić. Wkrótce zacznie się bitwa.~
@102 = ~Zauważasz, że te schody są niekompletne i nigdzie nie prowadzą.~
@103 = ~Nie byłoby wskazane teraz wychodzić.~
@104 = ~Te schody prowadzą na dach budynku, jednak niemądrym byłoby nań się wspinać.~
@105 = ~Następny poziom jest niedokończony.~
@106 = ~Wstęp do znajdującego się u szczytu tych schodów pomieszczenia mają jedynie mieszkający we Wzlatującej Duszy kapłani. Nie możesz wejść.~
@107 = ~Ten długi korytarz prowadzi do zejścia śmiertelnego.~
@108 = ~Niewidzialna ściana blokuje to przejście. Musisz znaleźć sposób na jej usunięcie.~
@109 = ~Zauważasz, że Odłamek kryształu unosi się w gigantycznym pojemniku.~
@110 = ~Przejście jest zablokowane niewidzialną ścianą. Nie możesz w nie wejść.~
@111 = ~Schody są zablokowane niewidzialną ścianą. Nie możesz na nie wejść.~
@112 = ~Poprawianie istniejących stworzeń...~
@113 = ~Dodawanie nowych stworzeń...~
@114 = ~Najwyższy mag~
@115 = ~Regean~
@116 = ~Alenna~
@117 = ~Alesaryda~
@118 = ~Alissa~
@119 = ~Nie mogę dalej walczyć! Wycofuję się!~ [AlsFMor]
@120 = ~Zaszczytem jest dotychczasowa wędrówka z tobą.~ [AlsHap]
@121 = ~Zboczyliśmy nieco z naszej drogi...~ [AlsUAn]
@122 = ~Powstrzymaj się, proszę. Równowaga powinna być zachowywana.~ [AlsUSr]
@123 = ~Myślę, że najlepiej będzie, jeśli rozdzielimy swe ścieżki. Nasze cele są całkowicie odmienne.~ [AlsUBr]
@124 = ~Ech... Nie znam się na tym...~ [AlsLead]
@125 = ~Potrzebuję nieco odpoczynku...~ [AlsTir]
@126 = ~Nie masz pomysłu, co powinniśmy teraz uczynić?~ [AlsBor]
@127 = ~Jeśli mam walczyć, niech i tak będzie!~ [AlsBat1]
@128 = ~Zrobię, co powinnam!~ [AlsBat2]
@129 = ~Zabiję cię, jeśli będę musiała!~ [AlsBat3]
@130 = ~Oj!~ [AlsDam]
@131 = ~*umiera*~ [AlsDie]
@132 = ~Proszę! Potrzebuję leczenia!~ [AlsHurt]
@133 = ~Kiedy byłam dzieckiem, zwykle bawiłam się w lesie...~ [AlsFor]
@134 = ~Większość mego życia spędziłam pośród ciszy i spokoju. Naprawdę nie przepadam za miastami z tymi wszystkimi krążącymi wokół ludźmi.~ [AlsCit]
@135 = ~To miejsce przenika mnie chłodem...~ [AlsDun]
@136 = ~Wschód słońca wyglądał pięknie w świątyni, w której żyłam. Powinnam zabrać cię tam pewnego dnia.~ [AlsDay]
@137 = ~Wędrówka w środku nocy... Zwykłam lepiej ją wykorzystywać...~ [AlsNig]
@138 = ~Jest coś, w czym mogłabym ci pomóc?~ [AlsCom1]
@139 = ~Co mogę dla ciebie uczynić?~ [AlsCom2]
@140 = ~To coś ważnego?~ [AlsCom3]
@141 = ~Jestem potrzebna?~ [AlsCom4]
@142 = ~Potrzebujesz moich umiejętności?~ [AlsCom5]
@143 = ~Cóż to?~ [AlsCom6]
@144 = ~Zrobię to, jak tylko potrafię najlepiej.~ [AlsAct1]
@145 = ~Możesz uważać to za zrobione.~ [AlsAct2]
@146 = ~Oczywiście.~ [AlsAct3]
@147 = ~Nie ma sprawy.~ [AlsAct4]
@148 = ~Tak będzie.~ [AlsAct5]
@149 = ~Nie zawiodę cię.~ [AlsAct6]
@150 = ~Najszybciej jak potrafię.~ [AlsAct7]
@151 = ~Po prostu fart, jak sądzę!~ [AlsCrH]
@152 = ~Ach!~ [AlsCrM]
@153 = ~Nikomu nie mogę pomóc...~ [AlsImm]
@154 = ~Wybacz, ale nie mogę przyjąć już więcej.~ [AlsIFul]
@155 = ~Przykro mi... Nie mogłam tego zatrzymać.~ [AlsLM]
@156 = ~Zapytana o przeszłość ALISSA wpierw zamyślona milczy, by następnie rozpocząć opowieść. Urodziła się, jako dziecko kapłańskiej pary, w świątyni poświęconej Deneirowi. Nauka Deneira została jej przekazana jeszcze we wczesnej młodości, od tego czasu pędziła całkiem przyjemny żywot pod ścisłym nadzorem kapłanów. Chłonęła ich wiedzę i, ku ich zachwytowi, wydawała się być ucieleśnieniem wiary. Błyskawicznie przyswajała wiedzę, co więcej potrafiła uczynić właściwy użytek ze swych talentów. Jednakże kiedy miała szesnaście lat na własny użytek rozpoczęła studia nad pewnymi dziwnymi, magicznymi zdolnościami. Przyprawiło ją to nieomal o pomieszanie zmysłów, nie potrafiła też określić ich pochodzenia. Na tyle jednak ich się obawiała, lękała się ich potęgi, że nigdy nie powiedziała o nich nikomu, nawet swoim rodzicom.

Ku rozczarowaniu kapłanów, w wieku lat dwudziestu, Alissa opuściła świątynię. Powodami były: chęć poznania otaczającego świata i, bardziej tajone, pragnienie dowiedzenia się czegoś więcej o swoich umiejętnościach. Mimo zapoznania się z zawartością rozlicznych ksiąg i dyskusji z kilkoma kapłanami, nie znalazła żadnej traktującej o nich wzmianki czy informacji. Przepełniona lękiem przed potęgą tychże zdolności, za wszelką cenę stara się dowiedzieć o nich więcej.~
@157 = ~Alora~
@158 = ~Al'thur~
@159 = ~Anna~
