@560 = ~Jarlaxle~
@561 = ~Myślę, że razem zrobimy to naprawdę dobrze!~ [JARLAX01]
@562 = ~Hmm...~ [JARLAX02]
@563 = ~Mam nadzieję, że zdajesz sobie sprawę, że powinniśmy z Entrerim dbać o złą reputację...~ [JARLAX03]
@564 = ~Cóż, nabędę nieco doświadczenia...~ [JARLAX04]
@565 = ~Wystarczy na dziś! Nawet ja jestem wykończony!~ [JARLAX05]
@566 = ~*ziewa*~ [JARLAX06]
@567 = ~Czas na zabijanie!~ [JARLAX07]
@568 = ~Ha! Założę się, że nawet nie zobaczysz ciosu!~ [JARLAX08]
@569 = ~Chodź! Zabiorę się za ciebie!~ [JARLAX09]
@570 = ~Uch!~ [JARLAX12]
@571 = ~Co... to... jest...?~ [JARLAX11]
@572 = ~... Ja... całkiem poważnie krwawię...~ [JARLAX10]
@573 = ~Ech, mam szczerą nadzieję, że nie idziemy do moich naziemnych krewniaków...~ [JARLAX13]
@574 = ~Lepiej, jak będę tutaj ostrożny...~ [JARLAX14]
@575 = ~Zastanawiam się, jak im w Menzoberranzan się wiedzie. Minęło sporo czasu, odkąd byłem tam po raz ostatni.~ [JARLAX15]
@576 = ~Przyzwyczajam się do wędrowania w świetle dnia...~ [JARLAX16]
@577 = ~Nocą mogę podróżować naprawdę swobodnie...~ [JARLAX17]
@578 = ~Czego chcesz?~ [JARLAX18]
@579 = ~Mów szybko.~ [JARLAX19]
@580 = ~Lepiej, żeby to było coś ważnego...~ [JARLAX20]
@581 = ~Na Pajęczą Królową, dlaczego zawracasz mi głowę teraz!?~ [JARLAX21]
@582 = ~Mów. Słucham cię.~ [JARLAX22]
@583 = ~Tak?~ [JARLAX23]
@584 = ~Dlaczegóż nie mógłbym...?~ [JARLAX24]
@585 = ~Jeśli to ma sprawić, że poczujesz się lepiej...~ [JARLAX25]
@586 = ~Dobra, dobra.~ [JARLAX26]
@587 = ~Cóż, ty tu rządzisz...~ [JARLAX27]
@588 = ~Wolałbym raczej zrobić coś innego...~ [JARLAX28]
@589 = ~*ziewa* Zrobię to.~ [JARLAX29]
@590 = ~Jeśli to podstęp, to pożałujesz...~ [JARLAX30]
@591 = ~Pozdrowienia z Menzoberranzan!~ [JARLAX31]
@592 = ~Ups!~ [JARLAX32]
@593 = ~Hmm... Jest nie do ruszenia!~ [JARLAX33]
@594 = ~Ktoś inny może to wziąć!~ [JARLAX34]
@595 = ~Nikt nie zauważył!~ [JARLAX37]
@596 = ~To zaklęcie się zmarnowało!~ [JARLAX35]
@597 = ~Nie chciałbym być na miejscu tego, kto to uruchomi...~ [JARLAX36]
@598 = ~Zapytany o przeszłość JARLAXLE, były przywódca komuny złodziei, Bregan Da'erthe, działającej w drowim mieście Menzoberranzan, zaczyna swą opowieść od czasu tam spędzonego. Był najbardziej poważanym mężczyzną pośród drowów, ponadto znanym przez każdego w Podmroku. Słynie z wyważonego usposobienia, nigdy nie był widziany rozgniewanym. Owszem, jest zły do szpiku kości, ale nie może być obwiniony o okrucieństwo.

Pewnego dnia przybył do niego człowiek, Artemis Entreri, a jakiś czas później w jego ręce trafił potężny artefakt, Odłamek kryształu. Stworzył więc Kryształową Wieżę i zwabił doń Drizzta. Wtedy Entreri po raz ostatni starł się z Drizztem i sądził, że go zabił, Jednak Jarlaxle bez wiedzy Enrtreriego uratował mu życie.

To jednak nie koniec opowieści Jarlaxle'a. Nawet tak silny umysł jak jego został omamiony przez obietnice mocy i potęgi, których nie szczędził mu Odłamek kryształu. Zaczął sprowadzać drowy do naziemnego świata i jakiegoś rodzaju najazd był tylko kwestią czasu. Został jednak zdradzony przez własnego człowieka i zbiegł z Kryształowej Wieży wraz z Artemisem Entrerim i Odłamkiem kryształu. Na oddziaływanie tego artefaktu odporny był Entreri, któremu przypadła nad nim piecza. Zdecydowali jednak go zniszczyć, w tym celu udali się do kapłana Cadderliusa, który rzeczywiście im w tym pomógł. Następnie rozpoczęli wspólne przemierzanie świata, aż do pewnego dnia, kiedy coś znaleźli...~
