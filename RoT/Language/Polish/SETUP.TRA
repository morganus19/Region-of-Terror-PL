@642 = ~Mordragon~
@643 = ~Wywołujesz u mnie uśmiech... To rani.~ [mordra02]
@644 = ~Wolałbym raczej robić coś innego niż pomaganie innym... Czymże takim sobie na to zasłużyli?~ [mordra03]
@645 = ~Ty i ja, nie stanowimy dobranej pary.~ [mordra04]
@646 = ~Wędrówka z tobą jest bezsensowna. Po co to kontynuować?~ [mordra05]
@647 = ~*prycha*~ [mordra06]
@648 = ~Stos ciał rośnie...~ [mordra09]
@649 = ~Czas umrzeć.~ [mordra10]
@650 = ~Zwyciężę!~ [mordra11]
@651 = ~Uch!~ [mordra12]
@652 = ~*umiera*~ [mordra13]
@653 = ~Jestem unurzany we krwi, jednak niczego nie czuję.~ [mordra14]
@654 = ~Wszyscy udają tak zajętych... To może być satysfakcjonujące, tylko kiedy w rzeczywistości twoje życie jest niczym.~ [mordra16]
@655 = ~Rozglądam się i widzę siebie.~ [mordra17]
@656 = ~Gotowy.~ [mordra20]
@657 = ~Potrzebujesz mnie?~ [mordra21]
@658 = ~Powiedz.~ [mordra22]
@659 = ~Co?~ [mordra23]
@660 = ~Tak?~ [mordra24]
@661 = ~Czas zabijać?~ [mordra25]
@662 = ~Dobrze.~ [mordra26]
@663 = ~Zrobię to.~ [mordra27]
@664 = ~Pewnie...~ [mordra28]
@665 = ~Dobra.~ [mordra29]
@666 = ~*wzdycha*~ [mordra30]
@667 = ~Świetnie.~ [mordra31]
@668 = ~Robi się...~ [mordra32]
@669 = ~Poczuj mój gniew!~ [mordra33]
@670 = ~Ach... Szlag!~ [mordra34]
@671 = ~Nie otrzymuje obrażeń!~ [mordra35]
@672 = ~Jeśli chcesz zachować głowę na swoim miejscu, każ zrobić to komuś innemu.~ [mordra36]
@673 = ~Nie mogłem się skupić... To zaklęcie przepadło.~ [mordra39]
@674 = ~Zapytany o przeszłość MORDRAGON staje w miejscu, przez jego twarz przebiega grymas bólu i mroczny cień, a następnie zaczyna swą opowieść. Jeszcze dwa lata temu wszystko przebiegało pomyślnie, został paladynem, był z wzajemnością zakochany w miejscowej damie, nic nie mogło uczynić go szczęśliwszym. Zaręczyny i zaślubiny były blisko. Niespodziewanie jednak przyszła zaraza i okrutnym zrządzeniem losu Mordragon przeżył jako jedyny w swoim rodzie. Już samo to można uznać za nieszczęście, jednak zmarła też wybranka jego serca. Mordragon czuł się winnym swego przetrwania i smucił się odniesionymi stratami, jednak nic nie potrafiło poprawić mu samopoczucia. Zbiegł w góry próbując znaleźć dawnego siebie, jednak to odeszło na dobre. Wszystko zostało mu odebrane, co wzbudziło jego gniew, gniew na świat, na każdego z osobna. Dlaczego powinien odczuwać szczęście, kiedy wszystko oferuje mu jedynie ból? Nie dbając o nic, udał się na wędrówkę bez celu poprzez doliny i lasy. Jego losy w ostatnich kilku miesiącach są zagadką nawet dla niego samego.~
@675 = ~Wyćwiczony bandyta~
@676 = ~Straceniec~
@677 = ~Większy olbrzymi troll~
@678 = ~Wyćwiczony apasz~
@679 = ~Młodszy król mykonidów~
@680 = ~Starszy król mykonidów~
@681 = ~Mistyczny miecz~
@682 = ~Wyćwiczony oprych~
