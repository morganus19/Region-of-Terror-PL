@812 = ~Dobra nasza, chłopcy!~ [TAPIO6]
@813 = ~Dobre jest to, że powstałem z martwych.~ [TAPIO7]
@814 = ~Sądzę, że wkrótce ponownie umrę.~ [TAPIO8]
@815 = ~Hmm... czy moje serce po prostu się zatrzymało?~ [TAPIO9]
@816 = ~No, tak, umieram.~ [TAPIO10]
@817 = ~Jestem urodzonym przywódcą.~ [TAPIO11]
@818 = ~*ziewa*~ [TAPIO12]
@819 = ~Dalej, zróbmy coś.~ [TAPIO13]
@820 = ~To mój styl!~ [TAPIO4]
@821 = ~Zakon Marii! Do boju! Do boju! Do boju!~ [TAPIO14]
@822 = ~Gdzie Magia! Gdzie Miecz!~ [TAPIO15]
@823 = ~Szlag!~ [TAPIO17]
@824 = ~Nieeeeeeeeeeeeeeee!~ [TAPIO38]
@825 = ~Do diabła, odpocznijmy!~ [TAPIO16]
@826 = ~Lubię lasy.~ [TAPIO18]
@827 = ~Lubię miasta.~ [TAPIO19]
@828 = ~Lubię podziemia.~ [TAPIO20]
@829 = ~Lubię dnie.~ [TAPIO21]
@830 = ~Lubię noce.~ [TAPIO22]
@831 = ~Co znowu?~ [TAPIO23]
@832 = ~Hej!~ [TAPIO2]
@833 = ~Czego chcesz?~ [TAPIO24]
@834 = ~Tak, niedojdo?~ [TAPIO25]
@835 = ~Gdzie chcesz bym się teraz udał?~ [TAPIO26]
@836 = ~Co tym razem?~ [TAPIO27]
@837 = ~Zaczekaj chwilę.~ [TAPIO5]
@838 = ~Dobra, wodzu.~ [TAPIO28]
@839 = ~Ruszam.~ [TAPIO29]
@840 = ~Po prostu to co miałem do zrobienia.~ [TAPIO30]
@841 = ~Nie znowu.~ [TAPIO31]
@842 = ~Dobra, dobra, pójdę, tym razem.~ [TAPIO32]
@843 = ~Taa.~ [TAPIO33]
@844 = ~Dawaj!~ [TAPIO1]
@845 = ~Eh!~ [TAPIO39]
@846 = ~Bez skutku.~ [TAPIO34]
@847 = ~Nie mogę więcej nieść.~ [TAPIO35]
@848 = ~Hmm... czuję swędzenie.~ [TAPIO37]
@849 = ~Straciłem magię! Szlag!~ [TAPIO36]
