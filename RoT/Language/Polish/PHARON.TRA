@0    = ~Hej! Ty! Chciałbym zamienić z tobą słówko!~
@1    = ~Słyszałem, że pytałeś się o jaskinię. Może będę coś wiedział.~ ~Słyszałem, że pytałaś się o jaskinię. Może będę coś wiedział.~
@2    = ~Dobra. Mów, mężczyzno.~
@3    = ~Nareszcie! Powiedz mi, co wiesz.~
@4    = ~Wiesz o jaskini? Dobrze. Powiedz mi wszystko, co wiesz.~
@5    = ~Cóż, faktycznie jest tu w pobliżu wioski jaskinia. Na mapie znajduje się tutaj.~
@6    = ~Wiem, co teraz sobie myślisz. Czemu wszyscy w wiosce twierdzą, że nie wiedzą nic o jaskini, a ja wręcz przeciwnie?~
@7    = ~Cóż, nie jestem do końca pewien odpowiedzi... ale podejrzewam, że innym zrobiono... pranie mózgu.~
@8    = ~Tak, oczywiście. To musi być to. Umysły ludzi są kontrolowane przecz człowieka, którego nazywają Artemis Entreri i przez drowa Jarlaxle'a.~
@9    = ~Cóż, a czemu z tobą wszystko w porządku?~
@10   = ~Cóż, dzięki za informację. Pójdę teraz do jaskini.~
@11   = ~Więc moje obawy okazały się słuszne... Kim są ci Artemis Entreri i Jarlaxle?~
@12   = ~Musiałem tylko zabić kilku gości. Nie martw się o nich.~
@13   = ~Jedyne co trzeba ci wiedzieć to, że są źli i muszą zostać powstrzymani. Ale teraz mam pytanie. Czemu nie jesteś pod ich kontrolą tak, jak inni?~
@14   = ~Nie musisz wiedzieć. Pójdę ich teraz zabić.~
@15   = ~Jeśli ci się powiedzie ludzie zostaną uwolnieni? Naprawdę mam taką nadzieję.~
@16   = ~W porządku... mam nadzieję, że zabicie ich oswobodzi wioskę.~
@17   = ~Myślę, że to przez to, że byłem z dala od wioski przez ostatni tydzień. Ludzie musieli zostać zniewoleni, kiedy mnie tutaj nie było.~
@18   = ~Na początku niczego nie zauważyłem, ale zacząłem coś podejrzewać, kiedy nagle wszyscy zaczęli nagle zapominać rzeczy, o których każdy mieszkaniec wioski wie.~
@19   = ~Cóż, twoje podejrzenia są słuszne. Umysły ludzi rzeczywiście są kontrolowane. Zajmę się tym problemem. Nie masz powodu do zmartwień.~
@20   = ~Cóż, twoje podejrzenia są słuszne. Umysły ludzi są kontrolowane przez człowieka zwanego Artemis Entreri i drowa Jarlaxle'a.~
@21   = ~Cóż, dzięki za informacje. Wyruszę teraz do jaskini.~
@22   = ~W porządku. Do widzenia.~
@23   = ~Cóż, Dobra. Zamierzam to wkrótce zakończyć. Zabiję Artemisa Entreriego i Jarlaxle'a. Twoi pobratymcy zostaną uwolnieni.~
@24   = ~Cóż, nie martw się. Zajmę się tym problemem. Zabiję Entreriego i Jarlaxle'a i położę temu kres.~
@25   = ~Cóż... świetnie! Będę czekać!~
@26   = ~Więc moje obawy okazały się słuszne... Skąd wiesz, że oni są pod kontrolą?~
@27   = ~Nie musisz wiedzieć. Jestem po twojej stronie. Zamierzam to zakończyć.~
@28   = ~Cóż, ci, którzy zniewolili umysły twych ludzi są moimi wrogami. Zamierzam ich zabić. Miasto zostanie po tym oswobodzone.~
@29   = ~Powodzenia!~
@30   = ~Mieszkańcy wioski nie są już zniewoleni! Wiem, że to ty ich oswobodziłeś! Dziękuję ci!~ ~Mieszkańcy wioski nie są już zniewoleni! Wiem, że to ty ich oswobodziłaś! Dziękuję ci!~
@31   = ~To wstyd, że nikt inny tutaj nie wie o twoich heroicznych czynach...~