@0    = ~Hej tam! Chciałbyś zarobić pięćdziesiąt sztuk złota za proste zadanie?~ ~Hej tam! Chciałabyś zarobić pięćdziesiąt sztuk złota za proste zadanie?~
@1    = ~Pewnie! Co muszę zrobić?~
@2    = ~A na czym to proste zadanie miałoby polegać?~
@3    = ~Nie interesuje mnie to. Żegnam.~
@4    = ~Cóż, parę dni temu przypadkowo mój pierścień wpadł mi do ścieków. Odnajdź go i przynieś do mnie.~
@5    = ~Wygląda na prostą sprawę. Zrobię to.~
@6    = ~Dlaczego sam go nie wyciągniesz?~
@7    = ~Co w tym pierścieniu jest tak cennego, że jesteś gotów zapłacić mi pięćdziesiąt sztuk złota za wyciągnięcie go z kanałów?~
@8    = ~Nie mam czasu na bieganie za zgubionymi pierścionkami. Sam go sobie poszukaj.~
@9    = ~Wspaniale! Na pewno rozpoznasz ten pierścień. Wygrawerowane są na nim imiona: moje – Garem, mego ojca oraz dziadka. Ktoś mógł na niego już trafić, więc może będzie trzeba go ukraść.~
@10   = ~Bo wiesz, w kanałach czai się pełno złodziei. Boję się tam pójść, ale ty z pewnością dasz sobie radę.~
@11   = ~Cóż, wygląda na proste zadanie. Zrobię to.~
@12   = ~Jest dla mnie bardzo ważny. Był w mojej rodziny od pokoleń, a zgubienie go byłoby wielkim wstydem.~
@13   = ~Wróć, jeśli zmienisz zdanie.~
@14   = ~Znalazłeś go?~ ~Znalazłaś go?~
@15   = ~Tak, mam go tutaj. Proszę.~
@16   = ~Tak, ale nie dam ci go, chyba że zapłacisz sto sztuk złota.~
@17   = ~Nie, ale wkrótce zacznę go szukać.~
@18   = ~Bardzo ci dziękuję! Oto obiecane złoto. Świetnie się spisałeś.~ ~Bardzo ci dziękuję! Oto obiecane złoto. Świetnie się spisałaś.~
@19   = ~Co to ma znaczyć? Umówiliśmy się, że znajdziesz pierścień, a ja zapłacę pięćdziesiąt sztuk złota.~
@20   = ~Wiem. Tylko żartowałem. Oto pierścień.~ ~Wiem. Tylko żartowałam. Oto pierścień.~
@21   = ~Tamta umowa nie ma znaczenia. Przyjmij nową, albo pożegnaj się z pierścieniem.~
@22   = ~Och, naprawdę mnie przestraszyłeś. Dzięki za pierścień. Oto obiecane złoto. Żegnaj!~ ~Och, naprawdę mnie przestraszyłaś. Dzięki za pierścień. Oto obiecane złoto. Żegnaj!~
@23   = ~W porządku! Masz sto. Teraz daj mi pierścień.~
@24   = ~Dziękuję. Pójdę już.~
@25   = ~Hmm... pierścień nie jest aż tyle warty. Oddasz mi go za pięćdziesiąt, albo kończymy rozmowę.~
@26   = ~W porządku! Bierz go i daj mi tę marną ilość obiecanego złota.~
@27   = ~Więc to koniec naszej rozmowy.~
@28   = ~Dobrze. Oto złoto. Teraz wybacz, muszę już iść.~
@29   = ~Oddasz mi ten pierścień czy nie? Uzgodniliśmy pięćdziesiąt sztuk złota i więcej z pewnością ci nie dam.~
@30   = ~Nie, nie oddam ci go za taką cenę. Żegnaj.~