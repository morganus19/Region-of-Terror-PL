@0    = ~KIM JESTEŚ!? JAK SIĘ TU DOSTAŁEŚ!?~ ~KIM JESTEŚ!? JAK SIĘ TU DOSTAŁAŚ!?~
@1    = ~Oooch! To mówi!~
@2    = ~Potrafisz mówić moim językiem? Zaskakujące, doprawdy.~
@3    = ~Nazywam się <CHARNAME>. Miło cię poznać.~
@4    = ~Nieważne kim jestem. Ważne jest to, po co tu jestem.~
@5    = ~Nieważne. Zabiję cię!~
@6    = ~TWOJA ZNIEWAGA JEST ŻAŁOSNA, ŚMIERTELNY. UMRZESZ ZA SWĄ IGNORANCJĘ!~ ~TWOJA ZNIEWAGA JEST ŻAŁOSNA, ŚMIERTELNA. UMRZESZ ZA SWĄ IGNORANCJĘ!~
@7    = ~Hmm... zanim to jednak nastąpi, moja pani, chciałbym zapytać, co robiłaś, zanim ci przeszkodziłem?~ ~Hmm... zanim to jednak nastąpi, moja pani, chciałabym zapytać, co robiłaś, zanim ci przeszkodziłam?~
@8    = ~JA, śmiertelny? Zabiłem wielu takich jak ty... Zobaczymy, kto z nas jest śmiertelny!~ ~JA, śmiertelna? Zabiłam wielu takich jak ty... Zobaczymy, która z nas jest śmiertelna!~
@9    = ~To TY zginiesz za SWOJĄ ignorancję!~
@10   = ~CIESZĘ SIĘ, MOGĄC STWIERDZIĆ, ŻE NIEDŁUGO SIĘ DOWIESZ... HAHAHA!~
@11   = ~HAHAHA! MYLISZ SIĘ. BĘDĘ SIĘ DELEKTOWAĆ PICIEM MOCY Z TWOJEJ DUSZY!~
@12   = ~HAHAHA!~
@13   = ~OCZYWIŚCIE, ŻE POTRAFIĘ PRZEMAWIAĆ TWOIM JĘZYKIEM! JESTEM BOGINIĄ!~
@14   = ~No wiesz... tak czy inaczej wątpię...~
@15   = ~Super! Naprawdę!? Nigdy wcześniej nie widziałem bogini!~ ~Super! Naprawdę!? Nigdy wcześniej nie widziałam bogini!~
@16   = ~Zobaczymy, komu z nas będzie bliżej do boskości po walce!~ ~Zobaczymy, której z nas będzie bliżej do boskości po walce!~
@17   = ~SPRAWI MI WIELE PRZYJEMNOŚCI, UDOWODNIENIE CI, ŻE SIĘ MYLISZ!~
@18   = ~HA! SKUTKI BĘDĄ DLA CIEBIE OPŁAKANE!~
@19   = ~BARDZO SIĘ CIESZĘ, ŻE CIĘ POZNAŁAM. TWA DUSZA JEST POTĘŻNA. Z RADOŚCIĄ JĄ POCHŁONĘ!~
@20   = ~I CO ZROBISZ, GŁUPCZE?~ ~I CO ZROBISZ, GŁUPIA?~
@21   = ~Nie wiem, co robisz, ale masz natychmiast przestać!~
@22   = ~Eee... wychodzę?~
@23   = ~HAHAHA! BĘDĘ SIĘ DELEKTOWAĆ PICIEM MOCY Z TWOJEJ DUSZY!~
@24   = ~NIE TAK SZYBKO! TWOJE CIAŁO MOŻE ODEJŚĆ, LECZ DUSZA JUŻ NIGDY NIE UJRZY ŚWIATŁA DZIENNEGO!~
@25   = ~ZROBIĘ TO SAMO Z WAMI!~
@26   = ~ŻONA? HAHAHA! ZABRALIŚMY PO PROSTU JEJ DUSZĘ. JESTEŚ TU, BY JĄ URATOWAĆ? NIEDOBRZE, BO ONA JUŻ NIE ŻYJE!~