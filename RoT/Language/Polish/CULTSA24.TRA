@0    = ~Wybierz pięć metod torturowania.~
@1    = ~Zmiażdż jej kolana.~
@2    = ~Wyłup jej oczy.~
@3    = ~Powoli odetnij jej język.~
@4    = ~Obetnij jej dłonie.~
@5    = ~Oderwij jej uszy.~
@6    = ~Potnij jej skórę.~
@7    = ~Wybij jej zęby.~
@8    = ~Złam jej kręgosłup.~
@9    = ~Okalecz jej głowę.~
@10    = ~Złam jej biodro.~
@11    = ~*niczego nie wybieraj*~
@12    = ~Wybierz kończącą metodę.~
@13    = ~Skręć jej kark.~
@14    = ~Wyrwij jej serce.~
@15    = ~Odrąb jej ręce, nogi i głowę.~
@16    = ~Powoli ją uduś.~
@17    = ~Wykrwaw ją na śmierć.~
@18    = ~Wybrano.~