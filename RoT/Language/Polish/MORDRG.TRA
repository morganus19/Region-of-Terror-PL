@0    = ~Widziałeś może złodzieja? Ubrany był na niebiesko i nosił czarną zbroję.~ ~Widziałaś może złodzieja? Ubrany był na niebiesko i nosił czarną zbroję.~
@1    = ~Tak. Pobiegł tędy.~
@2    = ~Nie mogę powiedzieć. Wybacz.~
@3    = ~Nie, nie widziałem. Dlaczego pytasz?~ ~Nie, nie widziałam. Dlaczego pytasz?~
@4    = ~Nie zawracaj mi głowy.~
@5    = ~Bardzo śmieszne.~
@6    = ~W porządku.~
@7    = ~Ma coś, co należy do mnie...~
@8    = ~Hmm... Mógłbym pomóc dopaść go.~ ~Hmm... Mogłabym pomóc dopaść go.~
@9    = ~W takim razie trzeba go znaleźć. Pomogę ci.~
@10   = ~Dobrze, powodzenia.~
@11   = ~Nie sądzę, bym potrzebował pomocy...~
@12   = ~Och przestań! To nie boli.~
@13   = ~Pozwolę ci się nim zająć, kiedy go znajdziemy...~
@14   = ~W takim razie zajmij się tym sam.~
@15   = ~Och, a jednak... To zdecydowanie może zaboleć... Dlaczego chcesz to zrobić?~
@16   = ~By zobaczyć, że sprawiedliwości staje się zadość.~
@17   = ~Chcę zobaczyć złodzieja umierającego w męczarniach.~
@18   = ~Ja również potrzebuję pomocy. Mam dla ciebie propozycję.~
@19   = ~Rozumiem... Sądzę, że mogę do ciebie dołączyć... Zrobię wszystko, żeby tylko się stąd wyrwać...~
@20   = ~Zanim ruszymy, musisz wiedzieć, że zamierzam ścigać potężnego maga, z którym mam rachunki do wyrównania. Nie będzie to bezpieczne.~
@21   = ~Zanim ruszymy, musisz wiedzieć, że chcę uratować przyjaciółkę z niewoli Zakapturzonych Czarodziejów. Wiąże się to z dużym niebezpieczeństwem.~
@22   = ~Dobrze, ruszajmy.~
@23   = ~Im niebezpieczniej, tym lepiej.~
@24   = ~Mamy więc taki sam cel. Przyjmuję twą pomoc.~
@25   = ~*odchrząkuje* Jakiego rodzaju propozycję?~
@26   = ~Pomogę ci odnaleźć złodzieja, a za to ty pomożesz mi zabić maga, który wpakował mnie w tarapaty.~
@27   = ~Pomogę ci odnaleźć złodzieja, a za to ty pomożesz mi uratować przyjaciółkę z rąk Zakapturzonych Czarodziejów.~
@28   = ~Brzmi nieźle. Poleje się krew... Przyjmuje twoją pomoc.~
@29   = ~W takim razie chodźmy.~
@30   = ~Nareszcie. Już nie mogłem się doczekać...~ ~Nareszcie. Już nie mogłam się doczekać...~
@31   = ~Świetnie. Sądzę, że miło będzie zabić kilku magów...~
@32   = ~Mamy więc coś wspólnego. Chodź.~
@33   = ~Poradzę sobie i bez ciebie.~
@34   = ~Och przestań! Pomaganie nie boli.~
@35   = ~Trzymaj język za zębami, chyba, że chcesz go stracić... razem z resztą głowy!~
@36   = ~Czego chcesz?~
@37   = ~Słuchaj... Dlaczego pytałeś o tego złodzieja?~
@38   = ~Niczego...~
@39   = ~Sądzę, że mógłbym pomóc dopaść go.~ ~Sądzę, że mogłabym pomóc dopaść go.~
@40   = ~Już mówiłem, że nie potrzebuję pomocy.~
@41   = ~Dobrze. Zostawię cię samego.~
@42   = ~Kim jesteś?~
@43   = ~Co tu robisz?~
@44   = ~Niczego. Już cię zostawiam.~
@45   = ~Mordragon.~
@46   = ~Masz tak bardzo zgaszony wzrok... Co się stało?~
@47   = ~Dlaczego jesteś taki przygnębiony?~
@48   = ~Cóż, pójdę już.~
@49   = ~Zajmij się swoimi sprawami.~
@50   = ~W porządku... Wygląda na to, że jesteś przy zdrowych zmysłach.~
@51   = ~W porządku. Na mnie już czas.~
@52   = ~Tak.~
@53   = ~Cóż, może chciałbyś do mnie dołączyć. Przydałby mi się ktoś taki jak ty.~
@54   = ~...Będę się zbierać.~
@55   = ~Nic.~