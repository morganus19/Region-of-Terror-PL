@0    = ~Wybierz pięć metod torturowania.~
@1    = ~Zmiażdż mu kolana.~
@2    = ~Wyłup mu oczy.~
@3    = ~Powoli odetnij mu język.~
@4    = ~Obetnij mu dłonie.~
@5    = ~Oderwij mu uszy.~
@6    = ~Potnij mu skórę.~
@7    = ~Wybij mu zęby.~
@8    = ~Złam mu kręgosłup.~
@9    = ~Okalecz mu głowę.~
@10    = ~Złam mu biodro.~
@11    = ~*niczego nie wybieraj*~
@12    = ~Wybierz kończącą metodę.~
@13    = ~Skręć mu kark.~
@14    = ~Wyrwij mu serce.~
@15    = ~Odrąb mu ręce, nogi i głowę.~
@16    = ~Powoli go uduś.~
@17    = ~Wykrwaw go na śmierć.~
@18    = ~Wybrano.~