@0    = ~Witam w moich skromnych progach! Obawiam się, że muszę cię poprosić o datek, zbiory bowiem nie zapewniły nam wystarczającej ilości pożywienia.~
@1    = ~Masz tu tysiąc sztuk złota, mój biedny człowieku! Bardziej potrzebujesz tych pieniędzy niż ja.~
@2    = ~Masz tu dwadzieścia sztuk złota. Myślę, że to ci wystarczy.~
@3    = ~Proszę, weź to. Pięć sztuk złota. Jestem pewien, że zrobisz z nich dobry użytek.~ ~Proszę, weź to. Pięć sztuk złota. Jestem pewna, że zrobisz z nich dobry użytek.~
@4    = ~Weź jedną sztukę złota, ty ohydny żebraku!~
@5    = ~Niczego ci nie dam! Twoja prośba jest oburzająca!~
@6    = ~Co!? Dź-dziękuję ci, panie. Nie potrafię znaleźć słów.~ ~Co!? Dź-dziękuję ci, pani. Nie potrafię znaleźć słów.~
@7    = ~Cóż, te pieniądze na pewno się przydadzą. Mam nadzieję, że będę mógł dać ci coś w zamian...~
@8    = ~O, tak! Ogromnie ci dziękuję! Te pieniądze są nam bardzo potrzebne.~
@9    = ~Ogromnie ci dziękuję, panie. Masz moje szczere podziękowania.~ ~Ogromnie ci dziękuję, pani. Masz moje szczere podziękowania.~
@10   = ~Nie jestem ohydnym żebrakiem! Nic od ciebie nie wezmę!~
@11   = ~Cóż, powinienem był się domyślić. Przepraszam, panie.~ ~Cóż, powinienem był się domyślić. Przepraszam, pani.~
@12   = ~Dziękuję za złoto. Bardzo go potrzebowaliśmy.~
@13   = ~Proszę, opuść mój dom.~
@14   = ~Przepraszam.~