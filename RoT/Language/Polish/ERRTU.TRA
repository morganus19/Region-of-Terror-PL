@0    = ~OCZEKIWAŁEM CIEBIE, DRIZZCIE DO'URDEN.~ [Errtu1]
@1    = ~OTRZYMAŁEM POMOC OD... TWOJEGO PRZYJACIELA, ARTEMISA.~ [Errtu2]
@2    = ~HAHAHA! WYMYŚLIŁEM. POTEM, GDY ZABIJĘ WSZYSTKICH INNYCH, PONOWNIE Z TOBĄ ZAGRAM, WULFGARZE.~ [Errtu3]
@3    = ~KIM JEST TEN SZCZUR?~ [Errtu5]
@4    = ~Nazywam się <CHARNAME>. Sławne dziecię Bhaala.~
@5    = ~Nie twoja sprawa. Odpowiedz na moje pytanie.~
@6    = ~Hmm... Po prostu GIŃ!~
@7    = ~DZIECIĘ BHAALA!? INTERESUJĄCE, TWYM OJCEM JEST BÓG MORDU.~
@8    = ~Bardzo interesujące, ale przejdźmy do pytania.~
@9    = ~Wydaje mi się, że nie mam już nic do dodania. GIŃ!~
@10   = ~HA! A CO JEŚLI NIE ODPOWIEM?~
@11   = ~Wtedy umrzesz.~
@12   = ~Cóż, to twoja decyzja. Mam nadzieje, że będziesz współpracować.~
@13   = ~CÓŻ, WYDAJE MI SIĘ, ŻE MOGĘ PRZEPROWADZIĆ KRÓTKĄ ROZMOWĘ Z DZIECKIEM BHAALA, ZANIM JE ZABIJĘ. PYTAJ!~
@14   = ~Dobrze, masz jakiekolwiek informacje o tym, co Entreri mógł mieć na myśli?~
@15   = ~Czy wiesz gdzie jest ten Entreri?~
@16   = ~Jak Entreri wyciągnął cię z piekieł? Jak powiedział Drizzt, zostało ci wiele lat, zanim będziesz mógł wrócić.~
@17   = ~Nie mam więcej pytań. Już czas byś poznał swoją zgubę.~
@18   = ~CHA CHA CHA!! NIECH I TAK SIĘ STANIE!~ [Errtu4]
@19   = ~CHA CHA CHA! NAPRAWDĘ JESTEŚ ŻAŁOSNĄ ISTOTĄ. ALE DOBRZE, ODPOWIEM NA TWE... PYTANIA.~
@20   = ~WIEM TYLKO, ŻE JESTEM TU, ABY ZABIĆ DRIZZTA DO'URDEN.~
@21   = ~POWINIENEŚ BARDZIEJ MARTWIĆ SIĘ O TO, CO JA MIAŁEM NA MYŚLI...~ ~POWINNAŚ BARDZIEJ MARTWIĆ SIĘ O TO, CO JA MIAŁEM NA MYŚLI...~
@22   = ~W takim razie, czy wiesz gdzie jest ten Entreri?~
@23   = ~WIEM TYLKO TYLE, ŻE JEST W KRYSZTAŁOWEJ WIEŻY.~
@24   = ~W Kryształowej Wieży? Co to za Kryształowa Wieża?~
@25   = ~Masz jakiekolwiek informacje o tym, co Entreri mógł mieć na myśli?~
@26   = ~NIE WIESZ!? CÓŻ, KRYSZTAŁOWA WIEŻA STANOWI TWÓR ODŁAMKA KRYSZTAŁU.~
@27   = ~ODŁAMEK KRYSZTAŁU TO NIEZWYKLE POTĘŻNY PRZEDMIOT, KTÓRY MOŻE BYĆ UŻYTY DO KONTROLOWANIA I ZWODZENIA UMYSŁU.~
@28   = ~PEWNEGO DNIA GŁUPIEC ENTRERI GO STRACI, A WTEDY BĘDZIE MÓJ!~
@29   = ~UŻYŁ ODŁAMKA KRYSZTAŁU. TO NAPRAWDĘ POTĘŻNY PRZEDMIOT...~
@30   = ~Odłamek kryształu? Czym jest Odłamek kryształu?~
@31   = ~Masz jakiekolwiek informacje o tym, co Entreri mógł mieć na myśli?~
@32   = ~Czy wiesz gdzie jest ten Entreri?~
@33   = ~NIE WIESZ!? ODŁAMEK KRYSZTAŁU TO NIEZWYKLE POTĘŻNY PRZEDMIOT, KTÓRY MOŻE BYĆ UŻYTY DO KONTROLOWANIA I ZWODZENIA UMYSŁU.~
@34   = ~COŚ JESZCZE?~
@35   = ~OCZYWIŚCIE. JA JESTEM NAJSILNIEJSZY.~ [Errtu6]
@36   = ~GDZIE JEST DRIZZT?~
@37   = ~AACH...~
@38   = ~WYBRAŁEŚ ŚMIERĆ.~ [Errtu7] ~WYBRAŁAŚ ŚMIERĆ.~ [Errtu7]