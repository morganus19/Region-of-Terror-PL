@0    = ~Proszę mi wybaczyć, panie.~ ~Proszę mi wybaczyć, pani.~
@1    = ~Mam wystarczająco dużo pieniędzy, by wydostać się na statku z tego miejsca. Spędziłem tutaj całe życie i nie mogę się zdecydować, co zrobić. Co byś zrobił na moim miejscu, panie?~ ~Mam wystarczająco dużo pieniędzy, by wydostać się na statku z tego miejsca. Spędziłem tutaj całe życie i nie mogę się zdecydować, co zrobić. Co byś zrobiła na moim miejscu, pani?~
@2    = ~Nie wiem. Jedź.~
@3    = ~Nie wiem. Zostań.~
@4    = ~Mam dla ciebie doskonałe rozwiązanie, Rzucę za ciebie monetą. Orzeł – wyjeżdżasz, reszka – zostajesz..~
@5    = ~Musisz zrobić listę z tym, co przemawia za pozostaniem oraz za opuszczeniem. Następnie ją przeczytaj i na tej podstawie podejmij decyzję.~
@6    = ~To miłe miejsce. Nie wyjeżdżaj.~
@7    = ~To niezbyt mi pomogło...~
@8    = ~...~
@9    = ~Orzeł.~
@10   = ~I co myślisz o wyniku?.~
@11   = ~Nie wiem... miałem raczej nadzieję na drugą opcję...~
@12   = ~W porządku. O to chodziło. Teraz wiesz na pewno, co czujesz. Chcesz zostać.~
@13   = ~... Dzięki... chyba...~
@14   = ~Reszka.~
@15   = ~Nie wiem. Dobrze.~
@16   = ~Dobrze. A więc zostajesz.~
@17   = ~Hmm... brzmi ciekawie. Spróbuję.~
@18   = ~Spróbuję.~
@19   = ~Wcale mi nie pomagasz...~
@20   = ~Dzięki!~
@21   = ~Spróbowałem! Zadziałało. Wyjeżdżam!~
@22   = ~Powinienem wyjechać czy nie...?~
@23   = ~Wypływam następnym statkiem.~
@24   = ~Zaczynam myśleć, że powinienem jednak zostać...~
@25   = ~Ostatnio jest tu o wiele weselej!~
@26   = ~Znów jest miło tutaj mieszkać!~
@27   = ~Zaczynam rozważać od nowa decyzję o pozostaniu...~
@28   = ~Pójdę za twoją radą i zostanę.~
@29   = ~Znów zaczyna tu być całkiem wesoło.~
@30   = ~Nie wiem, co dokładnie się stało, ale myślę, że ludzie są teraz weselsi niż kiedykolwiek!~