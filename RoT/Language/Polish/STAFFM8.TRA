@0    = ~Będę dbać o przestrzeganie zasad na tej arenie.~
@1    = ~Więc jesteś tu, aby walczyć. Nazywasz się Korgan, jak słyszałem.~
@2    = ~Pozwól, że wyjaśnię ci zasady. Jest trzydziestu dwóch zawodników. Liczba ta maleje o połowę po każdej rundzie.~
@3    = ~Będziesz potrzebować pięciu zwycięstw, by sięgnąć po nagrodę. Walczysz do śmierci, ale każdy, kto zginie, zostanie wskrzeszony wraz z ekwipunkiem. Uleczymy cię po każdej walce.~
@4    = ~To wszystko. Gotowy do walki?~ ~To wszystko. Gotowa do walki?~
@5    = ~Więc jesteś tu, aby walczyć. Nazywasz się Tapio, jak słyszałem.~
@6    = ~Więc jesteś tu, aby walczyć. Nazywasz się Bruenor, jak słyszałem.~
@7    = ~Więc jesteś tu, aby walczyć. Nazywasz się Wulfgar, jak słyszałem.~
@8    = ~Więc jesteś tu, aby walczyć. Nazywasz się <CHARNAME> , jak słyszałem.~
@9    = ~Tak, zaczynajmy.~ 
@10   = ~Dawajcie ich! Jestem gotowy!~ ~Dawajcie ich! Jestem gotowa!~
@11   = ~Więc jesteś tu, aby walczyć. Nazywasz się Mazzy, jak słyszałem.~
@12   = ~Jesteś tu, aby walczyć? Powinieneś już znać zasady. Gotowy na walkę?~ ~Jesteś tu, aby walczyć? Powinnaś już znać zasady. Gotowa na walkę?~
@13   = ~Zaczynajmy.~
@14   = ~Dawajcie ich!~
@15   = ~Walki zostały zakończone. Wróć za rok.~