@0    = ~Piętnastopoziomowy mag byłby odpowiednio dobry. Hmm... Nie masz wystarczająco potężnego czarodzieja w drużynie. Wróć, jeśli będziesz mieć.~
@1    = ~Witaj, wędrowcze! Chcesz wziąć udział w pojedynkach magów? Mogą w nich wziąć udział magowie o poziomie wyższym niż czternasty.~
@2    = ~Aerie jest potężną czarodziejką. Ona będzie walczyć.~
@3    = ~Edwin jest potężnym magiem. Może spróbować.~
@4    = ~Ja jestem potężnym czarodziejem. Wezmę udział.~ ~Ja jestem potężną czarodziejką. Wezmę udział.~
@5    = ~Randall jest potężnym magiem. On weźmie udział.~
@6    = ~Nie, nie jestem zainteresowany.~ ~Nie, nie jestem zainteresowana.~
@7    = ~Ona? W porządku, zatem niech walczy. Proszę wejść w portal, pani.~
@8    = ~On? W porządku, zatem niech walczy. Proszę wejść w portal, panie.~
@9    = ~Hmm... Rozumiem. Będziesz walczyć osobiście. Proszę wejść w portal, panie.~ ~Hmm... Rozumiem. Będziesz walczyć osobiście. Proszę wejść w portal, pani.~
@10   = ~Cóż, Edwinowi się nie powiodło. Przykro mi.~
@11   = ~Miejsce dla zwycięzcy! Edwin wrócił jako Ostateczny Mag.~
@12   = ~Wygrałeś, Edwinie? Gratuluję!~
@13   = ~Oczekiwaliśmy, że wygra.~
@14   = ~Edwin jest Ostatecznym Magiem. Gratuluję wam wszystkim.~
@15   = ~Cóż, Aerie się nie powiodło. Przykro mi.~
@16   = ~Miejsce dla zwyciężczyni! Aerie wróciła jako Ostateczny Mag.~
@17   = ~Co!? Wygrałaś, Aerie? Doskonale!~
@18   = ~Dobra robota Aerie. Dałaś popis.~
@19   = ~Ha, jak takie beztalencie, jak Aerie, mogło wygrać?~
@20   = ~Aerie jest Ostatecznym Magiem. Gratuluję wam wszystkim.~
@21   = ~Beztalencie? Mylisz się. Ta dama jest naprawdę potężną czarodziejką.~
@22   = ~Miejsce dla zwycięzcy! <CHARNAME> wrócił jako Ostateczny Mag.~ ~Miejsce dla zwyciężczyni! <CHARNAME> wróciła jako Ostateczny Mag.~
@23   = ~Gratuluję zwycięstwa, <CHARNAME>. Dobra robota!~
@24   = ~<CHARNAME> jest niepokonanym magiem. Gratuluję wam wszystkim.~
@25   = ~Randall jest niepokonanym magiem. Gratuluję wam wszystkim.~
@26   = ~Miejsce dla zwycięzcy! Randall wrócił jako Ostateczny Mag.~
@27   = ~Wygrałeś, Randallu? Gratuluję!~
@28   = ~Cóż, Randallowi się nie powiodło. Przykro mi.~