@0    = ~Czego chcesz?~
@1    = ~Parę tygodni temu przyprowadzono tu chłopca. Gdzie on jest?~
@2    = ~Coś dziwnego się tu dzieje. Kilka tygodni temu w tym budynku zniknął chłopiec. Mów, co tu się dzieje!?~
@3    = ~Kilka tygodni temu przyprowadziłeś tu chłopca wbrew jego woli. Mów, co się tu dzieje, albo zginiesz!~
@4    = ~J-ja nie wiem, o czym mówisz.~
@5    = ~Jesteś handlarzem niewolników! Nie próbuj zaprzeczać.~
@6    = ~Lepiej zacznij mówić. Przecież już wiem. Nie pogarszaj swej sytuacji.~
@7    = ~Hej, wiem o chłopcu i nie wyjdę, póki nie dowiem się gdzie jest, więc lepiej zacznij gadać.~
@8    = ~Koniec! Już nie żyjesz!~
@9    = ~Szlag by to! Jak na to wpadłeś?~ ~Szlag by to! Jak na to wpadłeś?~
@10   = ~Inteligencja, przyjacielu. Inteligencja. Ale do rzeczy, mów! Gdzie jest chłopiec?~
@11   = ~Nieważne. Mów, gdzie jest chłopiec, albo cię zabiję.~
@12   = ~Hmm... *rozważa, czy da radę cię pokonać*.~
@13   = ~Cóż, w porządku... powiem... ale musisz mnie puścić wolno. Oni mnie zabiją, jeśli się dowiedzą.~
@14   = ~W każdym razie handlarze niewolników używają mojego domu jako magazynu. Co miesiąc płacą niezłą sumkę w złocie.~
@15   = ~Zabierali niewolników przez kanały poza miasto i odprowadzali na północ, gdzie ich sprzedawali.~
@16   = ~Chłopiec, o którym mowa, jest z nimi. Zabrali go wczoraj, więc z łatwością ich złapiesz. Podróżują tym szlakiem.~
@17   = ~Kiedy ich znajdziesz... upewnij się, że nikt nie przeżył... nie pozwól im mnie zabić...~
@18   = ~Myślę, że cię po prostu zabiję!~
@19   = ~Cóż... W porządku... Chłopiec został schwytany, by zostać niewolnikiem... Handlarze niewolników używają mojego domu jako magazynu... Dużo płacą...~
@20   = ~Powinienem był wiedzieć! Gdzie jest chłopiec?~ ~Powinnam była wiedzieć! Gdzie jest chłopiec?~
@21   = ~Dobrze. Teraz mów, gdzie jest chłopiec!~
@22   = ~Cóż... Każdego miesiąca zabierali niewolników przez kanały poza miasto. Potem odprowadzali na północ, gdzie ich sprzedawali.~