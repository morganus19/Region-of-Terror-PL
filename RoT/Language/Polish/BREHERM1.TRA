@0    = ~Witaj, nieznajomy.~ ~Witaj, nieznajoma.~
@1    = ~Kim jesteś?~
@2    = ~Mógłbyś mi wskazać drogę?~
@3    = ~Co mogę dla ciebie zrobić?~
@4    = ~Żegnaj.~
@5    = ~Jakie to ma znaczenie na dłuższą metę...?~
@6    = ~Idź na wschód, a potem na południe. Znajdziesz się w Bremen. Za skałami idź na zachód. Dotrzesz do jaskini.~
@7    = ~Idź na południe. Dotrzesz do lodowej świątyni.~
@8    = ~Czym jest lodowa świątynia?~
@9    = ~Oczywiście. W mieście czekają moje zapasy. Możesz tam pójść i mi je przynieść.~
@10   = ~W porządku. Uważaj to za zrobione.~
@11   = ~A czemu sam ich sobie nie przyniesiesz?~
@12   = ~To nie jest praca dla kogoś takiego jak ja...~
@13   = ~Kilkadziesiąt lat temu mieszkali tam mnisi.~
@14   = ~Przejęły ją potwory i od tego czasu żaden człowiek nie odważył się tam pójść.~
@15   = ~Dziękuję ci nieznajomy.~ ~Dziękuję ci nieznajoma.~
@16   = ~Złamałem nogę i spacer pośród potworów nie jest dobrym pomysłem... jednakże nie wiem czemu, ale wydaje mi się, że wcale mnie nie atakują...~
@17   = ~Dobrze, zrobię to.~
@18   = ~W żadnym wypadku, to nie jest praca na moją miarę...~
@19   = ~Rób, jak uważasz.~
@20   = ~A więc spotykamy się ponownie.~
@21   = ~Masz zapasy?~
@22   = ~Tak. Oto one.~
@23   = ~Nie, jeszcze nie.~
@24   = ~Dziękuję. Zdaje się, że jest tu wszystko.~
@25   = ~Wydajesz się być dobrą osobą. Jest coś jeszcze, co mógłbyś dla mnie zrobić.~ ~Wydajesz się być dobrą osobą. Jest coś jeszcze, co mogłabyś dla mnie zrobić.~
@26   = ~Zgubiłem cenny kamień. Prawdopodobnie zabrał go jakiś potwór przechodzący w pobliżu tej chaty.~
@27   = ~Mógłbyś spróbować go odnaleźć.~ ~Mogłabyś spróbować go odnaleźć.~
@28   = ~Jasne! Już się robi.~
@29   = ~Nie mam żadnego powodu, żeby to robić.~
@30   = ~Znajdź sobie kogoś innego na posyłki.~
@31   = ~Dziękuję ci.~
@32   = ~Nie, raczej nie... chociaż... Być może i masz.~
@33   = ~Hmm... zrobię to.~
@34   = ~Nie interesuje mnie to. Znajdź sobie kogoś innego.~
@35   = ~Mam twoje zapasy.~
@36   = ~Witaj.~
@37   = ~Myślę, że jednak mogę poszukać tego kamienia.~
@38   = ~Bardzo dobrze, dziękuję.~
@39   = ~Masz mój kamień?~
@40   = ~Tak. Oto on.~
@41   = ~Nie, jeszcze nie.~
@42   = ~Aaach, jest. Dziękuję. Myślę, że teraz mogę już umrzeć...~
@43   = ~Możesz otworzyć pudełko, jeśli chcesz...~
@44   = ~Mam twój kamień. Oto on.~