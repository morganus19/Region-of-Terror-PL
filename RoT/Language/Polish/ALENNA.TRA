@0    = ~Czego chcesz?~
@1    = ~Jestem tu, by porozmawiać o zwoju, który ukradłaś Maraldzie.~
@2    = ~Muszę z tobą porozmawiać.~
@3    = ~Niczego...~
@4    = ~Co!? Jak śmiesz? Nie jestem złodziejką. Nigdy w życiu niczego nie ukradłam. To oburzające!~
@5    = ~Czyżby? Hmm... czy tam w twojej kieszeni, to nie jest zwój? Pozwól mi go zobaczyć...~
@6    = ~W takim razie nie będziesz miała nic przeciwko, jeśli zajrzę do tej szafki?~
@7    = ~Och, rozumiem. Przepraszam, że cię niepokoiłem, pani. Pójdę już sobie.~ ~Och, rozumiem. Przepraszam, że cię niepokoiłam, pani. Pójdę już sobie.~
@8    = ~Żarty sobie stroisz!? Łapy przy sobie!~
@9    = ~Szczerze mówiąc, będziesz w poważnych tarapatach, jeśli znajdę przy tobie ten zwój.~
@10   = ~Heh, tylko cię sprawdzałem. Wierzę, że nie zabrałaś tego zwoju.~ ~Heh, tylko cię sprawdzałam. Wierzę, że nie zabrałaś tego zwoju.~
@11   = ~Nie będziesz dotykać moich rzeczy!~
@12   = ~A po co mi pozwolenie? Zajrzę do twojej szafki, kiedy tylko będę chciał.~ ~A po co mi pozwolenie? Zajrzę do twojej szafki, kiedy tylko będę chciała.~
@13   = ~Przepraszam, nie zrobię tego. Wierzę, że nie zabrałaś zwoju.~
@14   = ~Jest magicznie zamknięta. Spróbuj ją otworzyć, jeśli chcesz.~
@15   = ~Niech to szlag! Rozkazuję ci otworzyć tę szafkę!~
@16   = ~Niech będzie. Teraz nic nie zrobię, ale jeśli dowiem się, że zabrałaś ten zwój, wrócę.~
@17   = ~Nie możesz mi rozkazywać. Wyjdź stąd, zanim zawołam straż.~
@18   = ~Dobrze, ale ja tu wrócę.~
@19   = ~Rób, co chcesz.~
@20   = ~W porządku, nie zwariowałeś jednak do reszty. Idź porozmawiaj z Melanem. Według mnie, to on zabrał ten zwój.~ ~W porządku, nie zwariowałaś jednak do reszty. Idź porozmawiaj z Melanem. Według mnie, to on zabrał ten zwój.~
@21   = ~Dobrze. Jeśli o mnie chodzi, sądzę że to Melan, ten śmierdzący szczur, zabrał zwój.~
@22   = ~Nie zabrałam go. Zapamiętaj to.~
@23   = ~Wierzę ci. Idę porozmawiać z tym złodziejem Melanem.~
@24   = ~Dobrze, widzę, że jesteś mądrzejszy, niż sądziłam.~ ~Dobrze, widzę, że jesteś mądrzejsza, niż sądziłam.~
@25   = ~Och, dobrze. Idź porozmawiaj z tym szczurem, Melanem. Według mnie, to on go zabrał.~
@26   = ~Co? Streszczaj się, nie mam czasu na głupoty.~
@27   = ~Myślę, że ukradłaś zwój Maraldy.~
@28   = ~W zasadzie to niczego. Pójdę już sobie.~
@29   = ~Bardzo dobrze. Nie marnuj mojego czasu.~
@30   = ~Rozmawiałem z magami – Maraldą i Melanem. Mam wszelkie powody, żeby twierdzić, że ukradłaś Maraldzie zwój z zaklęciem.~ ~Rozmawiałam z magami – Maraldą i Melanem. Mam wszelkie powody, żeby twierdzić, że ukradłaś Maraldzie zwój z zaklęciem.~
@31   = ~Wiem, że ukradłaś Maraldzie zwój. Oddaj mi go, a być może puszczę cię wolno.~
@32   = ~To nie ja! To Melan~
@33   = ~W takim razie nie będziesz miała nic przeciwko, jeśli zajrzę do tej szafki??~
@34   = ~Nie! Wyjdź stąd natychmiast!~
@35   = ~Wyjdź stąd albo zawołam straże!~
@36   = ~Nigdzie się nie wybieram, a zanim zawołasz straże, Melan chciałby coś zrobić.~
@37   = ~Idź porozmawiać z Melanem.~
@38   = ~Co!? O co chodzi? Czemu włazisz do mojego pokoju?~
@39   = ~Otwieramy twoją szafkę. Melanie, twoja kolej.~
@40   = ~Co, o co chodzi!?~
@41   = ~To oburzające! T-to nie ja, to on...~
@42   = ~Przestań! To bezcelowe... Dziękuję ci za pomoc, Melanie, chodźmy.~
@43   = ~Oszczędź sobie zbędnych przeprosin, Alenno. Chodźmy.~
@44   = ~Proszę, zostaw mnie.~
@45   = ~Co ty tu jeszcze robisz? Czy nie dostałeś już wszystkiego, czego chciałeś?~ ~Co ty tu jeszcze robisz? Czy nie dostałaś już wszystkiego, czego chciałaś?~
@46   = ~Chciałem tylko wiedzieć, czemu zabrałaś ten zwój.~ ~Chciałam tylko wiedzieć, czemu zabrałaś ten zwój.~
@47   = ~Tak. Już wychodzę.~
@48   = ~Nie twoja sprawa. A teraz się wynoś.~
@49   = ~Zdradziłeś nas! Wynoś się z mojego pokoju!~ ~Zdradziłaś nas! Wynoś się z mojego pokoju!~