@0    = ~Co, gdzie ja jestem? Kim jesteś?~ [Wu_BR1]
@1    = ~Jestem <CHARNAME>. To zaszczyt móc cię poznać.~
@2    = ~Jestem słynnym Dzieckiem Bhaala, imieniem <CHARNAME>. Zostałem uprowadzony i przywiedziony tutaj. Nie mam pojęcia, gdzie się znajdujemy.~ ~Jestem słynnym Dzieckiem Bhaala, imieniem <CHARNAME>. Zostałam uprowadzona i przywiedziona tutaj. Nie mam pojęcia, gdzie się znajdujemy.~
@3    = ~Nie wiem, gdzie jesteśmy. Odejdź.~
@4    = ~C-co to za miejsce?~
@5    = ~Nie wiem. Zostałem porwany i nie wiem, jak długo tu jestem. Ale szukam wyjścia. A ty jak się tu dostałeś?~ ~Nie wiem. Zostałam porwana i nie wiem, jak długo tu jestem. Ale szukam wyjścia. A ty jak się tu dostałeś?~
@6    = ~Nie wiem. Zostałem tu przyprowadzony wbrew woli. A ty jak się tu dostałeś?~ ~Nie wiem. Zostałam tu przyprowadzona wbrew woli. A ty jak się tu dostałeś?~
@7    = ~Cóż, podróżowałem razem z towarzyszami, używając zaklęcia teleportacji, ale coś poszło nie tak. Obudziłem się tutaj i nie mam pojęcia, gdzie są moi przyjaciele.~
@8    = ~Cóż, może dołączysz do mnie i razem poszukamy wyjścia stąd, panie...?~
@9    = ~Interesujące. Żegnaj.~
@10   = ~Wulfgar, syn Beornegara. To będzie zaszczyt dołączyć do ciebie, ale pamiętaj, że musimy znaleźć moich przyjaciół... Mam nadzieję, że też są tutaj.~
@11   = ~Pewnie. Ruszajmy.~
@12   = ~W porządku, nie ma sprawy.~
@13   = ~To znowu ty. Czego chcesz?~
@14   = ~Chciałbym, żebyś dołączył do mnie, byśmy razem poszukali wyjścia stąd.~ ~Chciałabym, żebyś dołączył do mnie, byśmy razem poszukali wyjścia stąd.~
@15   = ~Nic. Bywaj.~
@16   = ~Dobrze... Dołączę... Ale pamiętaj o moich przyjaciołach... Mam nadzieję, że też tu są.~
@17   = ~<CHARNAME>? Nigdy o tobie nie słyszałem... Mówisz, że nie wiesz, gdzie jesteśmy. Może powinniśmy razem poszukać wyjścia...?~
@18   = ~Oczywiście, przyjacielu, ale kim ty jesteś i jak się tu dostałeś?~
@19   = ~Nie, nie sądzę.~
@20   = ~Jestem Wulfgar, barbarzyńca z Doliny Lodowego Wichru. Podróżowałem razem z towarzyszami, używając zaklęcia teleportacji, ale coś poszło nie tak, jak powinno. Obudziłem się tutaj i nie wiem, gdzie są moi przyjaciele.~
@21   = ~W porządku, Wulfgarze. Chodźmy.~
@22   = ~W porządku, powinniśmy już ruszać.~
@23   = ~Może jednak mimo wszystko nie powinniśmy razem podróżować. Bywaj!~
@24   = ~Chodźmy więc, wiedz jednak, że będę się rozglądał za swymi przyjaciółmi, kiedy będziemy podróżować... Mam nadzieję, że też tu są.~
@25   = ~Jak sobie życzysz. Żegnaj więc.~
@26   = ~Pozdrowienia, <CHARNAME>. Delly będzie czekać w namiocie. Pójdzie z nami, kiedy wyruszymy. Jestem pewien, że możemy na chwile zboczyć z obranej ścieżki i odprowadzić ją do domu.~
@27   = ~Ale teraz już chodźmy.~