@0    = ~*wzdycha* ... Mam nadzieję, że ktoś mógłby mi pomóc...~
@1    = ~Może ja? W czym problem?~
@2    = ~Hmm... Jakiej pomocy potrzebujesz?~
@3    = ~Też mam. Żegnaj.~
@4    = ~Ktoś skradł mój magiczny zwój. Jest dla mnie bardzo cenny.~
@5    = ~Byłabym niewyobrażalnie wdzięczna, gdyby ktoś go dla mnie odzyskał.~
@6    = ~Jak „ktoś” może go odzyskać bez wskazówki, gdzie może być?~
@7    = ~Masz pomysł, kto mógł go zabrać?~
@8    = ~Cóż, nie mogę ci pomóc. Wybacz.~
@9    = ~Nie, nie. Mam wskazówkę. Wiem, że to była Alenna albo Melan, oboje żyją w zamku. Po prostu nie mogę udowodnić, które z nich go zabrało.~
@10   = ~Hmm.... Dowiem się, które z nich to zrobiło i przyniosę ci zwój.~
@11   = ~Interesujące. Mogę się tym zająć... jeśli nagroda będzie odpowiednia.~
@12   = ~To dla mnie zbyt trudne. Nie pomogę ci. Żegnaj.~
@13   = ~Co? Dziękuję! Bardzo dziękuję! Jestem bardzo wdzięczna. Będę tu na ciebie niecierpliwie czekać!~
@14   = ~Czego chcesz?~
@15   = ~Nocy... z tobą...~
@16   = ~Masz jakieś wartościowe przedmioty?~
@17   = ~Wyłącznie złota.~
@18   = ~Sądzę, że mimo wszystko mogę to zrobić za darmo.~
@19   = ~Jeśli zmienisz zdanie, będę tutaj.~
@20   = ~Tak. Wiem, że to była Alenna albo Melan. Oboje mieli okazję do kradzieży, ale każde z nich zaprzecza.~
@21   = ~W porządku. Wróć, jeśli zmienisz zdanie.~
@22   = ~B-bardzo dobrze... Będę twoja, jeśli zwrócisz mi zwój.~
@23   = ~Aaa... dobrze... Do zobaczenia później...~
@24   = ~Żartowałem, zrobię to za darmo.~ ~Żartowałam, zrobię to za darmo.~
@25   = ~Och, dzięki bogom! Nie, żebyś źle wyglądał, ale... W każdym razie, dziękuję... Będę tu czekać... Dziękuję.~ ~Och, dzięki bogom! Nie, żebyś źle wyglądała, ale... W każdym razie, dziękuję... Będę tu czekać... Dziękuję.~
@26   = ~Obawiam się, że nie.~
@27   = ~Cóż, wydaje mi się, że mogę to zrobić za darmo.~
@28   = ~W takim razie nieco złota wystarczy.~
@29   = ~Zrobisz to? Dzięki! Bardzo dziękuję! Jesteś wspaniałą osobą. Będę tu niecierpliwie czekać!~
@30   = ~Mogę ci dać dwieście sztuk złota.~
@31   = ~Tyle wystarczy. Wrócę ze zwojem.~
@32   = ~Potrzebowałbym więcej. Nie zrobię tego.~ ~Potrzebowałabym więcej. Nie zrobię tego.~
@33   = ~Świetnie! Bardzo dziękuję! Będę tu niecierpliwie czekać!~
@34   = ~Cóż, jeśli zmienisz zdanie, będę tutaj.~
@35   = ~Masz z powrotem mój zwój?~
@36   = ~Nie, jeszcze nie.~
@37   = ~Tak, to Alenna była tą, która go zabrała.~
@38   = ~Czy dwieście sztuk złota wystarczy?~
@39   = ~Tak, zrobię to.~
@40   = ~Nie, żegnaj.~
@41   = ~Świetnie! Bardzo dziękuję! Proszę, znajdź mój zwój.~
@42   = ~Zechcesz mi teraz pomóc?~
@43   = ~Tak, myślę, że tak. Masz jakiś pomysł, kto mógł go ukraść?~
@44   = ~Nie, nie zechcę.~
@45   = ~Wróciłeś. Pomożesz mi teraz?~ ~Wróciłaś. Pomożesz mi teraz?~
@46   = ~Tak, pomogę ci. Za darmo.~
@47   = ~Daj mi trochę złota, a ci pomogę.~
@48   = ~Nie.~
@49   = ~Dzięki! Bardzo dziękuję! Będę tu na ciebie czekać.~
@50   = ~Mogę ci dać dwieście, nie więcej.~
@51   = ~Zgadzam się. Zdobędę dla ciebie ten zwój.~
@52   = ~To za mało. Nie pomogę ci.~
@53   = ~Och, dzięki. Bardzo dziękuję!~
@54   = ~Jeśli zmienisz zdanie, wróć proszę.~
@55   = ~Alenna... Nie pomyślałabym...~
@56   = ~Doniesiesz na nią?~
@57   = ~Cóż, na mnie już czas.~
@58   = ~Nie, myślę, że wyciągnęła z tego wnioski.~
@59   = ~Możesz mi teraz powiedzieć, co to za zwój?~
@60   = ~Obawiam się, że nie możesz tego wiedzieć.~
@61   = ~W porządku. Jeszcze raz dziękuję za odzyskanie dla mnie zwoju.~
@62   = ~Cóż, na mnie już czas. Daj mi jeszcze tylko pieniądze.~
@63   = ~Cóż, na mnie już czas. Daj mi pieniądze.~
@64   = ~Proszę. Dzięki za odzyskanie zwoju.~
@65   = ~Cóż, obiecałaś mi noc. Idziemy?~
@66   = ~Obiecałaś mi noc. Możemy więc iść?~
@67   = ~T-tak... Chodź, zaprowadzę cię do mojego pokoju.~
@68   = ~Więc... obiecałaś mi noc. Chodźmy.~
@69   = ~Dzięki za odzyskanie zwoju... i za miłą noc...~
@70   = ~Ty także nie byłaś zła...~
@71   = ~Tak, to była dobra noc, dla ciebie.~
@72   = ~Chcesz jeszcze?~
@73   = ~Tak, proszę!~
@74   = ~Z tobą? Zapomnij!~
@75   = ~Dzięki za odzyskanie mojego zwoju.~
@76   = ~Więc, to moje łóżko. Zaczynajmy...~
@77   = ~Wciąż jeszcze chcesz?~
@78   = ~Och, tak.~
@79   = ~Nie, nie jesteś tego warta.~
@80   = ~Mimo wszystko chcesz jeszcze?~
@81   = ~Nie, nie z tobą.~
@82   = ~Rzucę na nas czar szybkości. Zobaczmy jak to jest na przyspieszeniu.~
@83   = ~Hu... Jestem wykończona. Nie próbujmy już tego robić na przyspieszeniu.~
@84   = ~Och, tak!~
@85   = ~Nie, nie teraz.~
@86   = ~Obrzydliwy szczurze! Pomogłeś Olmarowi! Wynoś się!~
@87   = ~Cóż, myślę, że nasze interesy są już załatwione... z wyjątkiem nocy spędzonej z tobą, <CHARNAME>...~