@0    = ~Pomocy! Potrzebuję pomocy!~
@1    = ~Spokojnie, dobry człowieku. Co się stało?~
@2    = ~Co się stało?~
@3    = ~Szukaj jej gdzie indziej.~
@4    = ~Olbrzymy! Zabrały moją żonę do jaskini. Nie zostało jej zbyt wiele czasu! Proszę, uratuj ją!~
@5    = ~Będę zaszczycony mogąc ją uratować. Poczekaj tutaj.~ ~Będę zaszczycona mogąc ją uratować. Poczekaj tutaj.~
@6    = ~Czy jestem jedyną osobą, która może pomóc?~
@7    = ~Wybacz. Nie mam czasu. Zrób to sam.~
@8    = ~Ale olbrzymy zabrały moją żonę do jaskini! Nie zostało jej zbyt wiele czasu. MI nie zostało zbyt wiele czasu!~
@9    = ~Jestem jedyną osobą, która może pomóc?~
@10   = ~Nie wygląda to za dobrze. Sam ją ratuj.~
@11   = ~Tak! Nie mam czasu, by wrócić do miasta!~
@12   = ~W takim razie, sądzę, że muszę ci pomóc. Twoja żona znajduje się w tej jaskini?~
@13   = ~Tak! Proszę, przyprowadź ją z powrotem!~
@14   = ~...~
@15   = ~Dziękuję! Bardzo ci dziękuję, panie! Dziękuję!~ ~Dziękuję! Bardzo ci dziękuję, pani! Dziękuję!~
@16   = ~Znalazłeś ją!?~ ~Znalazłaś ją!?~
@17   = ~Nie, jeszcze nie.~
@18   = ~Tak, znalazłem ją. Obawiam się, że jest martwa.~ ~Tak, znalazłam ją. Obawiam się, że jest martwa.~
@19   = ~C-co się stało?~
@20   = ~Demon zawładnął jej ciałem.~
@21   = ~Zginęła w bohaterskiej walce z lodowymi olbrzymami.~
@22   = ~Proszę zostaw mnie samego...~
@23   = ~Rozumiem...~