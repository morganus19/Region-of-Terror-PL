@0    = ~Co chcesz wiedzieć?~
@1    = ~Wiesz, kto ma Znamię?~
@2    = ~Czy cieniowi stojącemu na lewo od ciebie można wierzyć?~
@3    = ~Czy Znamię jest w posiadaniu cienia na lewo od ciebie?~
@4    = ~Czy cieniowi stojącemu na prawo od ciebie można wierzyć?~
@5    = ~Czy Znamię jest w posiadaniu cienia na prawo od ciebie?~
@6    = ~Ty je masz. Ty masz Znamię.~
@7    = ~Nic.~
@8    = ~Tak.~
@9    = ~Kto?~
@10    = ~Hmm...~
@11    = ~Ty.~
@12    = ~Niech to szlag.~
@13    = ~Tak! Oczywiście!~
@14    = ~Nie mam więcej pytań.~
@15    = ~Tak, jest.~
@16    = ~Nie wiem.~
@17    = ~Źle! Giń!~