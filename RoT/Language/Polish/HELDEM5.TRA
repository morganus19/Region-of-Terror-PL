@0    = ~Co tu robicie, śmiertelni?~
@1    = ~Szukamy Smokodzierżcy. Sądzę, że jesteś w jego posiadaniu.~
@2    = ~Chcemy tylko wielbić cię, o wspaniały.~
@3    = ~Przybywamy, by cię zabić!~
@4    = ~Nic wielkiego. Po prostu chcemy cię poznać...~
@5    = ~Och? A jak niby chcesz go zdobyć?~
@6    = ~Dasz mi go, ot co.~
@7    = ~Zabijając cię oczywiście.~
@8    = ~Myślałem o dobiciu targu.~ ~Myślałam o dobiciu targu.~
@9    = ~Próbujesz mnie... przestraszyć? Hahaha!~
@10   = ~Dobrze... Oto moja propozycja: ty dostaniesz przedmiot, a ja dostanę twą duszę. Brzmi uczciwie? Hahaha!~
@11   = ~Doprawdy?~
@12   = ~Tak, potężny panie. Żyjemy dla ciebie.~
@13   = ~Cóż, tak.~
@14   = ~Oczywiście, że nie, idioto! Jesteśmy tu, by cię zabić!~
@15   = ~Najlepszym sposobem by mi służyć jest umrzeć.~
@16   = ~Zrobię to, wasza wspaniałość!~
@17   = ~Nie chcę umierać!~
@18   = ~Cóż... Cenię sobie swoje życie. I sądzę, że to ty jesteś tym, kto powinien zginąć.~
@19   = ~Hahaha! Oglądanie twojej śmierci będzie zabawne!~
@20   = ~Hahaha!~
@21   = ~Po prostu umrzyj.~
@22   = ~Hmm... Jestem nieco zmęczony, więc cię po prostu zabiję.~
@23   = ~Giń.~