@0    = ~Witajcie, śmiertelni. Nie powinniście byli tutaj przychodzić.~
@1    = ~Kim jesteś?~
@2    = ~Co to za miejsce?~
@3    = ~W takim razie wychodzimy.~
@4    = ~Jestem nikim. Jestem martwy. Nigdy więcej mnie już nie będzie. Jestem duchem. Nie mam imienia. Już nie. Nie, od kiedy zostałem zamordowany.~
@5    = ~Eee... żegnaj. (Przygłup!)~
@6    = ~Cóż, w takim razie już sobie pójdę.~
@7    = ~To było miejsce życia. To było miejsce dobra. Zmieniło się. Teraz to miejsce śmierci. Teraz to miejsce zła.~
@8    = ~Wiele lat temu była tu świątynia. Żyłem tu. Wtedy nadeszła zguba. Zabrali ciała. Zjedli ciała.~
@9    = ~Wyswobodzili dusze. Sprawili, że dusze popadły w szaleństwo. Zmusili dusze do służby.~
@10   = ~Byłem doświadczeniem. Nie mogę umrzeć. Już jestem martwy. Jestem wieczny. Dusza nie jest stworzona, by być wieczną. Jestem więzieniem własnego umysłu. Nie mogę uciec.~
@11   = ~Inni oszaleli. Inni służą. Inni nawiedzali nawy Lodowej Świątyni. To straszne miejsce obecnie.~
@12   = ~Chcę wejść do tej Lodowej Świątyni. Jak mogę się tam dostać?~
@13   = ~Kim są ci „oni”?~
@14   = ~Stracisz swą duszę. Oszalejesz. Będziesz służyć. Nie możesz otworzyć drzwi. Śmiertelni nie mogą wejść... Ale ja mogę je otworzyć.~
@15   = ~Nie mogę jednak do nich podejść. Są chronione. Jeśli przestaną, będę mógł podejść. Będę mógł je otworzyć. A ty będziesz mógł umrzeć.~ ~Nie mogę jednak do nich podejść. Są chronione. Jeśli przestaną, będę mógł podejść. Będę mógł je otworzyć. A ty będziesz mogła umrzeć.~
@16   = ~Dobrze! Uwolnię drzwi od tej ochrony!~
@17   = ~W porządku. Zobaczę, czy można zniszczyć ochronę.~
@18   = ~Dlaczego nie możesz podejść do drzwi?~
@19   = ~Cóż, to niedobrze... Sądzę, że powinienem już sobie pójść.~ ~Cóż, to niedobrze... Sądzę, że powinnam już sobie pójść.~
@20   = ~I zgiń próbując.~
@21   = ~Nie możesz.~
@22   = ~Oni są tam. Nie mogę do nich podejść. Nie mogę.~
@23   = ~W takim razie pójdę i zabiję „ich”. Wtedy będziesz mógł otworzyć drzwi.~
@24   = ~Zginiesz próbując.~
@25   = ~Módl się. Módl się, byś się nie dowiedział.~ ~Módl się. Módl się, byś się nie dowiedziała.~
@26   = ~Mądra decyzja...~
@27   = ~Powinieneś odejść.~ ~Powinnaś odejść.~
@28   = ~Tak też zrobię.~
@29   = ~Idziesz na pewną śmierć. Oszalejesz. Będziesz służyć.~
@30   = ~Wciąż żyjesz.~
@31   = ~Jesteś silny.~ ~Jesteś silna.~
@32   = ~Polubią cię.~
@33   = ~Już ich nie ma. Zabiłeś ich.~ ~Już ich nie ma. Zabiłaś ich.~
@34   = ~Eee... Na mnie już czas.~
@35   = ~Przy drzwiach. Zabiłeś ich.~ ~Przy drzwiach. Zabiłaś ich.~
@36   = ~Jasne, tamte drzwi... Posłuchaj, znasz jakiś sposób na ich otwarcie?~
@37   = ~Na mnie już czas.~
@38   = ~Mogę je otworzyć. Otworzę je. Ale ty umrzesz. Oszalejesz. I będziesz służyć.~
@39   = ~Sądzę, że widziałem już tę świątynię, ale drzwi są zamknięte. Znasz jakiś sposób na ich otwarcie?~ ~Sądzę, że widziałam już tę świątynię, ale drzwi są zamknięte. Znasz jakiś sposób na ich otwarcie?~
@40   = ~Jestem wieczny. Jestem martwy.~