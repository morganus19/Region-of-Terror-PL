@0    = ~Witam! Minęła chwila od pojawienia się tu ostatniego podróżnika. Około dwieście lat.~
@1    = ~Co to za miejsce?~
@2    = ~Dwieście lat. Jesteś pewien? Zdaje mi się, że pewni ludzie przyszli tu ostatnio z więźniem.~
@3    = ~Co!? Gdzie ja jestem? Jak mogę się stąd wydostać?~
@4    = ~Kim ty jesteś? Czego chcesz?~
@5    = ~Jest to zewnętrzna sfera graghów.~
@6    = ~Graghi to ludzie żyjący w tej sferze. Nie istnieje wiedza o ich początku ni końcu.~
@7    = ~Jestem strażnikiem ich... miasta.~
@8    = ~Graghi? Czym oni są?~
@9    = ~Strażnikiem ich miasta... Jak mogę się tam dostać?~
@10   = ~Więc, nikt tu nie przyszedł od dwustu lat... Jesteś pewien? Zdaje mi się, że mój przyjaciel ostatnio tu wchodził.~
@11   = ~Rozumiem. Jak mogę się stąd wydostać?~
@12   = ~Niczego...~
@13   = ~Nikt tu nie przyszedł od dwustu lat.~
@14   = ~Cóż, w takim razie co to za miejsce?~
@15   = ~Jak mogę się stąd wydostać?~
@16   = ~Nie możesz wrócić. Możesz iść tylko naprzód.~
@17   = ~Co mam przez to rozumieć? Co znajduje się dalej? Czemu nie mogę wrócić?~
@18   = ~Niech to szlag! Wobec tego, powiedz mi, co to jest za miejsce.~
@19   = ~Wyciągnięcie z ciebie jakichś informacji zdaje się być dosyć trudne. Wobec tego, powiedz mi, co to jest za miejsce.~
@20   = ~Jestem strażnikiem Graghii. Będziesz musiał mnie minąć, żeby porozmawiać z graghami.~
@21   = ~Jestem strażnikiem graghów. Będziesz musiał mnie minąć, żeby porozmawiać z graghami.~
@22   = ~Oni są graghami.~
@23   = ~Co za świetna odpowiedź! (Bałwan!) Cóż, mówisz, że strzeżesz ich miasta. Jak mogę się tam dostać?~
@24   = ~Tylko poprzez przejście testu.~
@25   = ~Jaki to rodzaj testu?~
@26   = ~Cóż, jak mogę się dostać do tej Graghii?~
@27   = ~Jestem strażnikiem miasta graghów. Będziesz musiał mnie minąć, żeby porozmawiać z graghami.~
@28   = ~Test Świętego. Możesz tu spotkać czterech Świętych.~
@29   = ~Porozmawiaj z każdym z nich i przejdź ich testy.~
@30   = ~Jeśli ci się powiedzie, przeprowadzę cię do Graghii.~
@31   = ~Więc, testy Świętych... wrócę, kiedy je przejdę.~
@32   = ~Hmm... W porządku, wrócę tu wkrótce.~
@33   = ~Będę czekać na twój powrót.~
@34   = ~Mówiłeś o teście. Jaki to rodzaj testu?~
@35   = ~Cóż, jak mogę się stąd wydostać?~
@36   = ~Cóż, jak mogę się wydostać z tego miejsca?~
@37   = ~O jakim rodzaju testu mówisz?~
@38   = ~Rozumiem. Cóż, nikt tu nie przyszedł od dwustu lat. Jesteś pewien? Zdaje mi się, że mój przyjaciel ostatnio się tu dostał.~
@39   = ~Rozumiem. Cóż, mówiłeś o teście. Jaki to rodzaj testu?~
@40   = ~Cóż, mówiłeś o teście. Jaki to rodzaj testu?~
@41   = ~Jestem strażnikiem Graghii. Będziesz musiał mnie minąć, żeby porozmawiać z graghami.~
@42   = ~Mówiłeś o Graghii. Jak mogę się tam dostać?~
@43   = ~Jaki to rodzaj testu, o którym mówisz?~
@44   = ~Więc strzeżesz miasta graghów. Jak mogę się tam dostać?~
@45   = ~Cóż, możesz mi powiedzieć kim są ci, których określasz mianem graghów?~
@46   = ~Mówiłeś, że pilnujesz Graghii. Jak mogę się tam dostać?~
@47   = ~Rozumiem. Więc strzeżesz Graghii. Jak mogę się tam dostać?~
@48   = ~Nie przeszedłeś jeszcze wszystkich testów.~ ~Nie przeszłaś jeszcze wszystkich testów.~
@49   = ~Przeszedłeś wszystkie testy. Pozwolę ci wejść do Graghii.~ ~Przeszłaś wszystkie testy. Pozwolę ci wejść do miasta Graghii.~