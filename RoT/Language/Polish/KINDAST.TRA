@0    = ~Witaj w moim sklepie! Czym mogę ci służyć?~
@1    = ~Chciałbym rzucić okiem na to, co masz na składzie.~ ~Chciałabym rzucić okiem na to, co masz na składzie.~
@2    = ~Szukam dobrze płatnej pracy.~
@3    = ~W tej chwili niczym, dzięki.~
@4    = ~Doskonale! Moje towary są najlepsze w całej okolicy!~
@5    = ~Cóż, mam pewien problem... Obawiam się, że w mieście jest jakiś złodziej, który kradnie moje złoto i towary.~
@6    = ~Wczoraj zauważyłem, że brakuje złota i kilku mikstur.~
@7    = ~Jeśli potrzebujesz pieniędzy, oto moja oferta. Pięćdziesiąt sztuk złota.~
@8    = ~Och, daj spokój. Chcę stu.~
@9    = ~Obawiam się, że potrzebuję siedemdziesięciu pięciu sztuk złota.~
@10   = ~Brzmi nieźle, zrobię to. Masz jakieś podejrzenia?~
@11   = ~Pięćdziesiąt sztuk złota? Chyba zwariowałeś!~
@12   = ~Cóż... Dobrze. To dużo, więc dobrze wykonaj swe zadanie... Nie mam najmniejszych podejrzeń, musisz sobie poradzić sam.~ ~Cóż... Dobrze. To dużo, więc dobrze wykonaj swe zadanie... Nie mam najmniejszych podejrzeń, musisz sobie poradzić sama.~
@13   = ~Na twoim miejscu, zacząłbym od pilnowania nocą tego budynku. Dostaniesz pieniądze, jeśli złapiesz złodzieja.~
@14   = ~Możesz na mnie liczyć. Dostanę złodzieja.~
@15   = ~Zostaw to mnie. Będziesz mieć złodzieja w swych rękach w okamgnieniu.~
@16   = ~Obawiam się, że nie. Sam musisz się czegoś dowiedzieć.~ ~Obawiam się, że nie. Sama musisz się czegoś dowiedzieć.~
@17   = ~Cóż, twój wybór.~
@18   = ~Cóż, upewnij się, że wrócisz.~
@19   = ~Zdecydowałem przyjąć twoją ofertę. Masz jakieś wskazówki?~ ~Zdecydowałam przyjąć twoją ofertę. Masz jakieś wskazówki?~
@20   = ~Doskonale! Dziękuję!... Obawiam się jednak, że nie mam żadnych tropów... Sam musisz jakieś znaleźć.~ ~Doskonale! Dziękuję!... Obawiam się jednak, że nie mam żadnych tropów... Sama musisz jakieś znaleźć.~
@21   = ~Dostaniesz pieniądze, kiedy złapiesz złodzieja. Zanim pójdziesz, zechcesz może sprawdzić, co mam na składzie?~
@22   = ~Tak, proszę.~
@23   = ~Nie, nie teraz. Może później.~
@24   = ~Cóż, nigdzie się stąd nie ruszam...~
@25   = ~Znalazłeś coś?~ ~Znalazłaś coś?~
@26   = ~Tak. Widziałem złodzieja, gdy wychodził ze sklepu. Miał na sobie ubranie w zielenie i brązy. Wiesz, kto to mógł być?~
@27   = ~Nie, ale chętnie zobaczę, co masz na sprzedaż.~
@28   = ~To niemożliwe! Jafet! ... Nie wierze, że to on... Proszę, dowiedz się, dlaczego to zrobił... Nie mogę w to uwierzyć...~
@29   = ~Proszę, dowiedz się, dlaczego to zrobił.~
@30   = ~Więc...?~
@31   = ~Jego żona jest poważnie chora, a ponieważ nie ma pieniędzy, musiał ukraść miksturę. Obiecałem mu, że zapłacę za nią... Och, i powiedział, że nigdy nie zabrał żadnych pieniędzy.~
@32   = ~Mówi prawdę. Źle policzyłem... I, cóż, jeżeli naprawdę chcesz zapłacić za tę miksturę, to nie widzę żadnych przeciwwskazań.~
@33   = ~Zobaczmy... Oto i twoja nagroda. Takie są skutki bycia dobrą osobą... Do zobaczenia! Miło robić z tobą interesy!~
@34   = ~Jego żona jest poważnie chora, a ponieważ nie ma pieniędzy, musiał ukraść miksturę. Och, i powiedział, że nigdy nie zabrał żadnych pieniędzy.~
@35   = ~Mówił prawdę. Źle policzyłem... Jego żona jest poważnie chora? Powinien poprosić o miksturę, dałbym mu ją... Ale, jeżeli już ją wziął, to może ją zatrzymać...~
@36   = ~No dobrze, weź swoją nagrodę.~
@37   = ~Sto sztuk złota... Proszę. Dziękuje za pomoc.~
@38   = ~Siedemdziesiąt pięć sztuk złota... Proszę. Dziękuje za pomoc.~
@39   = ~Pięćdziesiąt sztuk złota... Proszę. Dziękuje za pomoc.~
@40   = ~Chcesz zerknąć na moje towary?~
@41   = ~Nie, nie teraz.~