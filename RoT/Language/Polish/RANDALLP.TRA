@0    = ~Więc zostawiasz mnie?~
@1    = ~Obawiam się, że tak. W tej chwili nie ma dla ciebie miejsca.~
@2    = ~Nie, oczywiście, że nie.~
@3    = ~W porządku. Zatem wracam do Arlax...~
@4    = ~Dobra.~
@5    = ~Proszę, zaczekaj tutaj. Wkrótce po ciebie wrócę.~
@6    = ~Jesteś z powrotem. Kontynuujemy nasze przygody?~
@7    = ~Tak. Chodź.~
@8    = ~Nie, jeszcze nie.~
@9    = ~Jak sobie życzysz...~
@10   = ~Nie lubię cię. Źle postępujesz. Dlatego opuszczę cię teraz na dobre.~ [RAN_BR]