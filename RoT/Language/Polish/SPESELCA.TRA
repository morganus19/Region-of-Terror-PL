@0    = ~Ach, witaj, podróżniku. Sprzedaję czary. Chcesz zobaczyć, co mam na sprzedaż?~ ~Ach, witaj, podróżniczko. Sprzedaję czary. Chcesz zobaczyć, co mam na sprzedaż?~
@1    = ~Tak, pokaż mi swoje czary, proszę.~
@2    = ~Nie, nie mam teraz czasu na twoje zwoje.~
@3    = ~Nie pożałujesz tego! Mam najlepszy wybór w Amn!~
@4    = ~Cóż, upewnij się, że tu wrócisz!~
@5    = ~Wróciłeś! Przybywasz zobaczyć moje zwoje, prawda?~ ~Wróciłaś! Przybywasz zobaczyć moje zwoje, prawda?~
@6    = ~Tak, pokaż je.~
@7    = ~Nie, nie teraz. Może innym razem.~
@8    = ~Szczęściarz z ciebie, mam najlepszy wybór w Amn!~ ~Szczęściara z ciebie, mam najlepszy wybór w Amn!~
@9    = ~W porządku. Będę czekać!~
@10   = ~Przypuszczam, że nadal mogę sprzedać ci zwoje, pomimo że jesteś tym, który skazał nas na zagładę. Zainteresowany?~ ~Przypuszczam, że nadal mogę sprzedać ci zwoje, pomimo że jesteś tą, która skazała nas na zagładę. Zainteresowana?~
@11   = ~Tak, proszę.~
@12   = ~Nie, nie tym razem.~