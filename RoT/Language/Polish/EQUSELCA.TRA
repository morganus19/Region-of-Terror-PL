@0    = ~Witaj, podróżniku! Jestem zamkowym sprzedawcą ekwipunku.~ ~Witaj, podróżniczko! Jestem zamkowym sprzedawcą ekwipunku.~
@1    = ~Witaj. Mogę zerknąć na twoje towary?~
@2    = ~Mogę zadać kilka pytań?~
@3    = ~Cóż, może kiedyś coś od ciebie kupię... Do widzenia.~
@4    = ~Pewnie! Chodź i oglądaj.~
@5    = ~Jeśli potrzebujesz odpowiedzi na pytania, zadaj je Erandzie.~
@6    = ~Zrobię tak, ale zanim pójdę, chcę spojrzeć na twoje towary.~
@7    = ~Zrobię tak. Do zobaczenia, sprzedawco.~
@8    = ~Wróć kiedyś.~
@9    = ~Witam ponownie! Chcesz zobaczyć moje towary?~
@10   = ~Tak, pokaż mi.~
@11   = ~Właściwie chcę zadać parę pytań.~
@12   = ~Nie teraz, sprzedawco. Może innym razem.~
@13   = ~Oto one. Mam nadzieję, że będziesz zadowolony.~ ~Oto one. Mam nadzieję, że będziesz zadowolona.~
@14   = ~Eranda odpowie na twoje pytania.~
@15   = ~Dobrze. Chcę zobaczyć twoje towary.~
@16   = ~Dzięki, pójdę jej poszukać.~
@17   = ~W porządku. Będę tutaj czekać!~