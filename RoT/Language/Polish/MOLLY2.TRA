@0    = ~Witaj, panie. Nazywam się Molly. Jestem żoną Hedana.~ ~Witaj, pani. Nazywam się Molly. Jestem żoną Hedana.~
@1    = ~Cóż, witaj.~
@2    = ~Witam i żegnam.~
@3    = ~Wierzę, że nie mamy, o czym dłużej rozmawiać.~
@4    = ~Wyglądasz, jak poszukiwacz przygód... Mógłbyś coś dla mnie zrobić? Mogę zapłacić.~ ~Wyglądasz, jak poszukiwaczka przygód... Mogłabyś coś dla mnie zrobić? Mogę zapłacić.~
@5    = ~W czym problem?~
@6    = ~O jakiej sumie mówimy?~
@7    = ~Nie, nie potrzebuję teraz pieniędzy. Nie mam teraz czasu.~
@8    = ~Skradziono mój naszyjnik. Potrzebuję, byś odkrył, kto go ukradł i zwrócił go mnie. Jeśli ci się powiedzie, zapłacę.~ ~Skradziono mój naszyjnik. Potrzebuję, byś odkryła, kto go ukradł i zwróciła go mnie. Jeśli ci się powiedzie, zapłacę.~
@9    = ~Podejrzewam, że złodziejem był Burrich z dołu. Dziwnie się ostatnio zachowuje. Powinieneś z nim porozmawiać.~ ~Podejrzewam, że złodziejem był Burrich z dołu. Dziwnie się ostatnio zachowuje. Powinnaś z nim porozmawiać.~
@10   = ~W porządku, zrobię to. Wrócę do ciebie, kiedy złapię złodzieja.~ 
@11   = ~O jakiej sumie mówimy?~
@12   = ~Nie jestem tym zainteresowany. Wybacz.~ ~Nie jestem tym zainteresowana. Wybacz.~
@13   = ~Znalazłeś?~ ~Znalazłaś?~
@14   = ~Tak, jest tutaj.~
@15   = ~Nie, jeszcze nie.~
@16   = ~Doskonale! Dziękuję! Będę czekać na wasz powrót.~
@17   = ~Niezbyt wiele, pięćdziesiąt sztuk złota. Ale to małe zlecenie.~
@18   = ~Brzmi nieźle. Zrobię to.~
@19   = ~Nie będę biegać za naszyjnikiem za pięćdziesiąt sztuk złota. Wybacz.~
@20   = ~Cóż, przypuszczam, że mogę poprosić męża, by poszukał tego naszyjnika...~
@21   = ~Jakiego rodzaju zlecenie to będzie?~
@22   = ~To za mała kwota na cokolwiek. Nie zrobię tego.~
@23   = ~Skradziono mój naszyjnik. Chcę, byś odkrył, kto go ukradł i zwrócił go mnie.~ ~Skradziono mój naszyjnik. Chcę, byś odkryła, kto go ukradł i zwróciła go mnie.~
@24   = ~Wydaje się łatwe. Zrobię to.~
@25   = ~Nie mam czasu na łapanie przestępców. Wybacz.~
@26   = ~Cóż, mam nadzieję, że znajdę kogoś innego...~
@27   = ~Poproszę o to męża.~
@28   = ~Och, dziękuję ci! Kto go zabrał?~
@29   = ~„Zły człowiek”. Musiałem go zabić, żeby zdobyć naszyjnik.~ ~„Zły człowiek”. Musiałam go zabić, żeby zdobyć naszyjnik.~
@30   = ~„Zły człowiek”. Niełatwo było odzyskać ten naszyjnik...~
@31   = ~Co!? Zabiłeś go? Może mój naszyjnik jest bardziej wartościowy, niż mi się zdawało...~ ~Co!? Zabiłaś go? Może mój naszyjnik jest bardziej wartościowy, niż mi się zdawało...~
@32   = ~Nie mogę w to uwierzyć... Muszę zabrać naszyjnik do Athkatli tak szybko, jak to tylko możliwe.~
@33   = ~Cóż, dziękuję za pomoc i żegnaj.~
@34   = ~Hmm... Dziwne... Co on chciał osiągnąć kradnąc mój naszyjnik?..~
@35   = ~Dzięki za twą pomoc, panie.~ ~Dzięki za twą pomoc, pani.~