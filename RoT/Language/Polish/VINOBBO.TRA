@0    = ~Tak chciałbym móc poznać Drizzta Do'Urdena.~
@1    = ~Cóż, tak się składa, że jest właśnie tutaj.~
@2    = ~Jest bliżej, niż mogłeś sobie wyobrazić...~
@3    = ~Wiesz, kiedyś go spotkałem.~ ~Wiesz, kiedyś go spotkałam.~
@4    = ~Tak jak ja, chłopcze, tak jak ja...~
@5    = ~Nie kręć, ty mały szczurze!~
@6    = ~DRIZZT!? Super!! Jest moim bohaterem!~
@7    = ~Naprawdę!? Super! Ale ci zazdroszczę! Jaki on jest?~
@8    = ~Wspaniały kompan. Kiedyś też go poznasz.~
@9    = ~Był w porządku, jednak nic specjalnego.~
@10   = ~Jak wrzód na tyłku!~
@11   = ~Wiedziałem! Teraz chcę go zobaczyć jeszcze bardziej!~
@12   = ~Nie znasz się!~
@13   = ~Nie wierzę ci! Drizzt nie może być wrzodem na tyłku!~
@14   = ~Jesteś fajny. Lubisz Drizzta.~ ~Jesteś fajna. Lubisz Drizzta.~
@15   = ~Jesteś straszny! BUUUU!~
@16   = ~BUUUUUUUUUUUUUUU!~
@17   = ~Przyjaciel Drizzta jest moim przyjacielem. Nauczyłem się tego od mojego ojca.~
@18   = ~Nie mogę uwierzyć, że spotkałeś Drizzta Do'Urdena.~ ~Nie mogę uwierzyć, że spotkałaś Drizzta Do'Urdena.~
@19   = ~Mogę zobaczyć twoje sejmitary!?~
@20   = ~Super! One są świetne!~
@21   = ~Żegnaj Drizzcie! Jesteś wspaniały!~
@22   = ~Nie mogę uwierzyć, że poznałem Drizzta Do'Urdena!~